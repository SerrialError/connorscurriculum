---
import { CALLOUT_TYPES, type CalloutType } from '../lib/callouts';

interface Props {
  type?: CalloutType;
  title?: string;
}

const { type = 'note', title } = Astro.props;
const label = CALLOUT_TYPES[type];
if (!label) throw new Error(`<Callout type="${type}">: type must be note, warning, ap-tip, or not-on-ap`);
---

<aside class:list={['callout', type]}>
  <p class="callout-title"><span aria-hidden="true">{label.icon}</span> {title ?? label.text}</p>
  <div class="callout-body"><slot /></div>
</aside>
