---
// One released AP FRQ: links to the official PDFs, readiness, and either all parts with
// their topics or just the parts that matched a topic.
import { getSubjectData, learnedTopic, url } from '../lib/content';
import { type FrqLink, type FrqPart, frqName, frqTotal, readyPoints } from '../lib/frqs';

interface Props {
  subject: string;
  frq: FrqLink;
  /** Show only these parts (e.g. those on one topic). Omit to list every part with its topics. */
  matched?: FrqPart[];
}

const { subject, frq, matched } = Astro.props;
const data = getSubjectData(subject);
const learned = learnedTopic(data);
const total = frqTotal(frq);
const ready = readyPoints(frq, learned);
const matchedPoints = matched?.reduce((sum, p) => sum + p.points, 0) ?? 0;
const kind = frq.number <= 3 ? 'Long' : 'Short';
const marks = { done: '✓', review: '↺', partial: '◐' } as const;
---

<article class="card frq">
  <header>
    <h3>
      <a href={frq.questionUrl} target="_blank" rel="noopener">{frqName(frq)}</a>
      <span class="title">{frq.title}</span>
    </h3>
    <span
      class:list={['badge', { good: ready === total }]}
      title="Points in parts whose topics you have all learned (this year or last year)"
    >
      {ready === total ? '✓ Ready' : `${ready}/${total} pts ready`}
    </span>
  </header>
  <p class="small muted meta">{kind} answer · {total} points</p>

  {matched ? (
    <p class="small">
      Part{matched.length > 1 ? 's' : ''} {matched.map((p) => p.label).join(', ')} ({matchedPoints} pt{matchedPoints === 1 ? '' : 's'})
    </p>
  ) : (
    <ul class="plain-list parts">
      {frq.parts.map((p) => (
        <li>
          <span class="label">{p.label}</span>
          <span class="small muted pts">{p.points} pt{p.points === 1 ? '' : 's'}</span>
          <span class="badges">
            {p.cedTopics.map((t) => {
              const s = data.progress.topics.get(t);
              return (
                <a class="badge topic" href={url(`${subject}/ap/${t}/`)} title={data.topics.get(t)?.title}>
                  {s && <span aria-hidden="true">{marks[s]}</span>}
                  {t}
                </a>
              );
            })}
          </span>
        </li>
      ))}
    </ul>
  )}

  <p class="links small">
    <a href={frq.questionUrl} target="_blank" rel="noopener">Question (PDF)</a>
    <a href={frq.scoringUrl} target="_blank" rel="noopener">Scoring guidelines</a>
    {frq.samplesUrl && (
      <a href={frq.samplesUrl} target="_blank" rel="noopener">Sample responses</a>
    )}
  </p>
</article>

<style>
  .frq header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    align-items: baseline;
    justify-content: space-between;
  }
  h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .title {
    font-weight: 600;
    color: var(--text-2);
    margin-left: 0.3rem;
  }
  .meta {
    margin: 0.2rem 0 0.4rem;
  }
  .parts li {
    display: grid;
    grid-template-columns: 3.6rem 3rem 1fr;
    gap: 0.5rem;
    align-items: center;
    padding: 0.25rem 0;
    border-top: 1px solid var(--border);
  }
  .label {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0.6rem 0 0;
  }
</style>
