---
// One released AP FRQ: links to the official PDFs, readiness, and either all parts with
// their topics or just the parts that matched a topic.
import { getSubjectData, learnedTopic, url } from '../lib/content';
import { type FrqLink, type FrqPart, frqName, frqPractices, frqTotal, readyPoints } from '../lib/frqs';

interface Props {
  subject: string;
  frq: FrqLink;
  /** Show only these parts (e.g. those on one topic). Omit to list every part with its topics. */
  matched?: FrqPart[];
}

const { subject, frq, matched } = Astro.props;
const data = getSubjectData(subject);
const learned = learnedTopic(data);
const total = frqTotal(frq);
const ready = readyPoints(frq, learned);
const matchedPoints = matched?.reduce((sum, p) => sum + p.points, 0) ?? 0;
const kind = frq.number <= 3 ? 'Long' : 'Short';
const marks = { done: '✓', review: '↺', partial: '◐' } as const;
const practiceName = (id: string) => data.ced.sciencePractices.find((p) => p.id === id)?.name ?? `Practice ${id}`;
const skillOf = (id: string) => data.skills.get(id);
// Unique per page: each question appears at most once on a page.
const popId = (part: number, skill: string) => `skill-${frq.year}-q${frq.number}-${part}-${skill.replace('.', '')}`;
// When showing matched parts only, list the practices those parts use; otherwise the whole question's.
const practices = frqPractices({ parts: matched ?? frq.parts });
const sourceNote = frq.officialSkills
  ? 'Science practices as labeled by College Board.'
  : 'College Board has not published practice labels for this exam yet; these are our own.';
---

<article class="card frq">
  <header>
    <h3>
      <a href={frq.questionUrl} target="_blank" rel="noopener">{frqName(frq)}</a>
      <span class="title">{frq.title}</span>
    </h3>
    <span
      class:list={['badge', { good: ready === total }]}
      title="Points in parts whose topics you have all learned (this year or last year)"
    >
      {ready === total ? '✓ Ready' : `${ready}/${total} pts ready`}
    </span>
  </header>
  <p class="small muted meta">{kind} answer · {total} points</p>
  {practices.length > 0 && (
    <p class="practices" title={sourceNote}>
      {practices.map((id) => (
        <span class="practice">
          <span class="pnum">{id}</span>
          {practiceName(id)}
        </span>
      ))}
      {!frq.officialSkills && <span class="small muted">(our labels)</span>}
    </p>
  )}

  {matched ? (
    <p class="small">
      Part{matched.length > 1 ? 's' : ''} {matched.map((p) => p.label).join(', ')} ({matchedPoints} pt{matchedPoints === 1 ? '' : 's'})
    </p>
  ) : (
    <details class="parts-toggle">
      <summary>Show {frq.parts.length} parts</summary>
      <ul class="plain-list parts">
        {frq.parts.map((p, i) => (
          <li>
            <span class="label">{p.label}</span>
            <span class="small muted pts">{p.points} pt{p.points === 1 ? '' : 's'}</span>
            <span class="badges">
              {p.skills.map((id) => {
                const skill = skillOf(id);
                return (
                  <>
                    <button
                      type="button"
                      class="badge skill"
                      popovertarget={popId(i, id)}
                      aria-label={`Skill ${id}${skill ? `, ${skill.practice.name}` : ''}`}
                    >
                      {id}
                    </button>
                    <div popover id={popId(i, id)} class="skill-pop">
                      <p class="pop-practice">
                        Practice {skill?.practice.id}: {skill?.practice.name}
                      </p>
                      <p>
                        <strong>{id}</strong> {skill?.text}
                      </p>
                    </div>
                  </>
                );
              })}
              {p.cedTopics.map((t) => {
                const s = data.progress.topics.get(t);
                return (
                  <a
                    class="badge topic"
                    href={url(`${subject}/ap/${t}/`)}
                    title={data.topics.get(t)?.title}
                    aria-label={`Topic ${t}: ${data.topics.get(t)?.title}`}
                  >
                    {s && <span aria-hidden="true">{marks[s]}</span>}
                    {t}
                  </a>
                );
              })}
            </span>
          </li>
        ))}
      </ul>
    </details>
  )}

  <p class="links small">
    <a href={frq.questionUrl} target="_blank" rel="noopener">Question (PDF)</a>
    <a href={frq.scoringUrl} target="_blank" rel="noopener">Scoring guidelines</a>
    {frq.samplesUrl && (
      <a href={frq.samplesUrl} target="_blank" rel="noopener">Sample responses</a>
    )}
  </p>
</article>

<style>
  .frq header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    align-items: baseline;
    justify-content: space-between;
  }
  h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .title {
    font-weight: 600;
    color: var(--text-2);
    margin-left: 0.3rem;
  }
  .meta {
    margin: 0.2rem 0 0.4rem;
  }
  .parts li {
    display: grid;
    grid-template-columns: 3.6rem 3rem 1fr;
    gap: 0.5rem;
    align-items: center;
    padding: 0.25rem 0;
    border-top: 1px solid var(--border);
  }
  .parts-toggle summary {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--link);
    padding: 0.2rem 0;
  }
  .parts-toggle[open] summary {
    margin-bottom: 0.25rem;
  }
  .label {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .practices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    margin: 0 0 0.5rem;
  }
  .practice {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.1rem 0.55rem 0.1rem 0.15rem;
    border-radius: 0.8rem;
    border: 1px solid var(--border);
    color: var(--text-2);
  }
  .pnum {
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--surface-2);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .badge.skill {
    background: transparent;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .skill-pop {
    max-width: min(22rem, calc(100vw - 2rem));
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.25);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .skill-pop::backdrop {
    background: rgb(0 0 0 / 0.15);
  }
  .skill-pop p {
    margin: 0;
  }
  .pop-practice {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
    margin-bottom: 0.3rem !important;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0.6rem 0 0;
  }
</style>
