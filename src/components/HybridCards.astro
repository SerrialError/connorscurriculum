---
// <HybridCards />: one card per hybridization: what's mixed, how many hybrids, their geometry, what's
// left over for π bonds, and examples. sp³d and sp³d² are marked class-only (not on the AP exam).
const CARDS = [
  { name: 'sp', domains: 2, mixed: '1 s + 1 p', makes: '2 sp', shape: 'linear', angle: '180°', left: '2 p left over: up to 2 π bonds', examples: 'C in CO₂ and HC≡CH, Be in BeF₂', ap: true },
  { name: 'sp²', domains: 3, mixed: '1 s + 2 p', makes: '3 sp²', shape: 'trigonal planar', angle: '120°', left: '1 p left over: up to 1 π bond', examples: 'C in C₂H₄ and H₂CO, B in BF₃', ap: true },
  { name: 'sp³', domains: 4, mixed: '1 s + 3 p', makes: '4 sp³', shape: 'tetrahedral', angle: '109.5°', left: 'no p left over: no π bonds', examples: 'C in CH₄, N in NH₃, O in H₂O', ap: true },
  { name: 'sp³d', domains: 5, mixed: '1 s + 3 p + 1 d', makes: '5 sp³d', shape: 'trigonal bipyramidal', angle: '90°, 120°', left: '', examples: 'P in PCl₅, S in SF₄', ap: false },
  { name: 'sp³d²', domains: 6, mixed: '1 s + 3 p + 2 d', makes: '6 sp³d²', shape: 'octahedral', angle: '90°', left: '', examples: 'S in SF₆, Xe in XeF₄', ap: false },
];
---

<ul class="hybrid-cards">
  {
    CARDS.map((c) => (
      <li class:list={['hybrid-card', { 'class-only': !c.ap }]}>
        <p class="h-domains">{c.domains} electron domains</p>
        <p class="h-name">{c.name}</p>
        <p class="h-mix">
          {c.mixed} → <strong>{c.makes}</strong>
        </p>
        <p class="h-shape">
          {c.shape}, {c.angle}
        </p>
        {c.left && <p class="h-left">{c.left}</p>}
        <p class="h-ex">{c.examples}</p>
        <p class="h-ap">{c.ap ? <span class="badge topic">On the AP exam</span> : <span class="badge not-ap">Class only</span>}</p>
      </li>
    ))
  }
</ul>

<style>
  .hybrid-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 0.6rem;
    margin: 1rem 0 1.25rem;
    padding: 0;
    list-style: none;
  }
  .hybrid-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--border);
    border-top: 4px solid #8a5cd6;
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 0.85rem;
  }
  .hybrid-card.class-only {
    border-top-color: var(--border);
    background: var(--surface-2);
  }
  .hybrid-card p {
    margin: 0;
  }
  .h-domains {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .h-name {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.1;
  }
  .h-shape {
    font-weight: 600;
  }
  .h-left,
  .h-ex {
    color: var(--text-2);
  }
  .h-ap {
    margin-top: auto !important;
    padding-top: 0.3rem;
  }
</style>
