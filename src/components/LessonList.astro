---
import { type Lesson, groupLessons, lessonSlug, topicIds, url } from '../lib/content';
import TopicBadges from './TopicBadges.astro';
import TopicLegend from './TopicLegend.astro';

interface Props {
  lessons: Lesson[];
  showChapter?: boolean;
  /** Split into "Test review", "Lessons", and "Class notes" with subheadings. */
  grouped?: boolean;
  /** Heading level for group headings. */
  headingLevel?: 2 | 3;
  /** Shown when there are no lessons. */
  empty?: string;
  /** Show the key for the progress icons on topic badges. */
  legend?: boolean;
}

const { lessons, showChapter = false, grouped = false, headingLevel = 3, empty = 'No lessons yet.', legend = true } = Astro.props;
const groups = grouped ? groupLessons(lessons) : [{ kind: 'all', heading: '', lessons }];
const H = `h${headingLevel}` as 'h2' | 'h3';
---

{lessons.length === 0 ? (
  <p class="muted">{empty}</p>
) : (
  groups.map((g) => (
    <>
      {grouped && groups.length > 1 && <H class="group-h">{g.heading}</H>}
      <ul class="plain-list lessons card">
        {g.lessons.map((l) => (
          <li class:list={[l.data.kind]}>
            <a class="title" href={url(`${l.data.subject.id}/lessons/${lessonSlug(l)}/`)}>{l.data.title}</a>
            {l.data.draft && <span class="badge">Draft</span>}
            {l.data.summary && <p class="summary">{l.data.summary}</p>}
            <div class="meta">
              <span class="small muted">
                {showChapter && <>Ch. {l.data.chapter}{l.data.sections.length > 0 && <> · §{l.data.sections.join(', ')}</>} · </>}
                by {l.data.authors.join(', ')}
              </span>
              <TopicBadges subject={l.data.subject.id} topics={topicIds(l)} />
            </div>
          </li>
        ))}
      </ul>
    </>
  ))
)}
{legend && lessons.length > 0 && <TopicLegend subject={lessons[0]!.data.subject.id} topics={lessons.flatMap(topicIds)} />}

<style>
  .group-h {
    font-size: 1rem;
    margin: 1.25rem 0 0.5rem;
    color: var(--text-2);
  }
  .lessons {
    padding: 0 1.1rem;
  }
  .lessons li {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border);
  }
  .lessons li:last-child {
    border-bottom: 0;
  }
  .title {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .review .title::before {
    content: '★ ';
    color: var(--tip);
  }
  .summary {
    margin: 0.2rem 0 0.35rem;
    color: var(--text-2);
    font-size: 0.95rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    align-items: center;
    margin-top: 0.3rem;
  }
  .meta :global(.badge) {
    font-size: 0.75rem;
  }
</style>
