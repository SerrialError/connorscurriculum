---
// Class progress marker for a chapter or CED topic. Text label is always present
// (visually hidden in compact mode) so the state is not shown by color alone.
import type { TopicProgress } from '../lib/registry';

interface Props {
  status: TopicProgress;
  /** Icon only, with a hidden label. */
  compact?: boolean;
  /** Label for "done" (default "Learned"). */
  doneLabel?: string;
}

const { status, compact = false, doneLabel = 'Learned' } = Astro.props;
const label = status === 'done' ? doneLabel : status === 'partial' ? 'Partly learned' : 'Not yet';
const icon = status === 'done' ? '✓' : status === 'partial' ? '◐' : '';
---

{status && (
  <span class:list={['mark', status, { compact }]} title={label}>
    <span aria-hidden="true">{icon}</span>
    {compact ? <span class="visually-hidden">{label}</span> : <span>{label}</span>}
  </span>
)}
{!status && compact && <span class="mark none" aria-hidden="true"></span>}

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.3;
    padding: 0.15rem 0.55rem;
    border-radius: 0.8rem;
    white-space: nowrap;
  }
  .done {
    background: var(--good-soft);
    color: var(--good);
  }
  .partial {
    background: var(--warn-soft);
    color: var(--warn);
  }
  .compact {
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    font-size: 0.9rem;
    flex: none;
  }
  .none {
    display: inline-block;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }
</style>
