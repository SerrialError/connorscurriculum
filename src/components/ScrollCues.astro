---
// Tables and display equations wider than the screen get a "Scroll sideways for more" caption
// (styles in global.css) until they're scrolled. Used once, in Base.astro.
---

<script>
  // Practice renders questions after load, so re-check when the page changes.
  const markScrollers = () => {
    for (const el of document.querySelectorAll<HTMLElement>('main table, main .katex-display')) {
      const over = el.clientWidth > 0 && el.scrollWidth > el.clientWidth + 2;
      if (!over) el.removeAttribute('data-scrolls');
      else if (!el.hasAttribute('data-scrolls')) el.setAttribute('data-scrolls', '');
    }
  };
  let queued = false;
  const queueMark = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      markScrollers();
    });
  };
  markScrollers();
  addEventListener('resize', queueMark);
  document.addEventListener('toggle', queueMark, true);
  new MutationObserver(queueMark).observe(document.getElementById('main')!, { childList: true, subtree: true });
  document.addEventListener(
    'scroll',
    (e) => {
      const el = e.target;
      if (!(el instanceof HTMLElement) || !el.hasAttribute('data-scrolls')) return;
      if (el.scrollLeft > 2) el.setAttribute('data-scrolls', 'seen');
    },
    true,
  );
</script>
