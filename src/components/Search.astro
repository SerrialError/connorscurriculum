---
// Site search backed by Pagefind's JS API. The index only exists after `npm run build`.
import { subjectIds, url } from '../lib/content';

interface Props {
  placeholder?: string;
  /** Input id; must be unique on the page (the header search uses its own). */
  id?: string;
}

const { placeholder = 'Search lessons, chapters, topics…', id = 'site-search' } = Astro.props;
// With one class, every result is from it, so results don't repeat its name.
const showSubject = subjectIds().length > 1;
---

<div class="search" data-pagefind-src={url('pagefind/pagefind.js')} data-show-subject={showSubject ? '' : undefined}>
  <label class="visually-hidden" for={id}>Search</label>
  <input id={id} type="search" placeholder={placeholder} autocomplete="off" enterkeyhint="search" />
  <p class="status small muted" aria-live="polite"></p>
  <ol class="results plain-list"></ol>
  <button class="more link-button small" type="button" hidden>Show all results</button>
</div>

<script>
  import { isRealMatch, trimTitle } from '../lib/search-excerpt';

  interface PagefindResult {
    data(): Promise<{ url: string; excerpt: string; meta: Record<string, string> }>;
  }
  interface Pagefind {
    search(q: string): Promise<{ results: PagefindResult[] }>;
    options?(o: Record<string, unknown>): Promise<void>;
  }

  for (const root of document.querySelectorAll<HTMLElement>('.search')) {
    const input = root.querySelector('input')!;
    const status = root.querySelector<HTMLElement>('.status')!;
    const list = root.querySelector<HTMLOListElement>('.results')!;
    const more = root.querySelector<HTMLButtonElement>('.more')!;
    const PAGE = 8;
    let limit = PAGE;
    let pagefind: Pagefind | null = null;
    let failed = false;
    let timer: number | undefined;
    let seq = 0;

    async function load(): Promise<Pagefind | null> {
      if (pagefind || failed) return pagefind;
      try {
        pagefind = (await import(/* @vite-ignore */ root.dataset.pagefindSrc!)) as Pagefind;
      } catch {
        failed = true;
        status.textContent = 'Search works on the built site (npm run build && npm run preview).';
      }
      return pagefind;
    }

    async function run() {
      const q = input.value.trim();
      const mine = ++seq;
      if (!q) {
        list.replaceChildren();
        status.textContent = '';
        more.hidden = true;
        return;
      }
      const pf = await load();
      if (!pf) return;
      const search = await pf.search(q);
      if (!search) return; // superseded by a newer query
      const { results } = search;
      // Load a few more than are shown, so loose matches can be dropped and the count stays right
      // for small result sets (where loose matches show up).
      const loaded = await Promise.all(results.slice(0, Math.max(limit, 30)).map((r) => r.data()));
      if (mine !== seq) return;
      const kept = loaded.filter((r) => isRealMatch(q, r.excerpt));
      const total = results.length - (loaded.length - kept.length);
      const top = kept.slice(0, limit);
      status.textContent =
        total === 0
          ? 'No results. Try fewer or different words.'
          : total > top.length
            ? `Top ${top.length} of ${total} results`
            : `${total} result${total === 1 ? '' : 's'}`;
      list.replaceChildren(
        ...top.map((r) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = r.url;
          a.className = 'title';
          a.textContent = r.meta.title ?? r.url;
          // "Lesson · Chapter 6: …": what kind of page it is, and where it lives.
          const meta = document.createElement('div');
          meta.className = 'small muted result-meta';
          if (r.meta.type) {
            const tag = document.createElement('span');
            tag.className = 'type';
            tag.textContent = r.meta.type;
            meta.append(tag);
          }
          const where = [root.hasAttribute('data-show-subject') ? r.meta.subject : '', r.meta.chapter].filter(Boolean).join(' · ');
          if (where) meta.append(where);
          const excerpt = document.createElement('p');
          excerpt.className = 'small';
          // Pagefind escapes page text and adds <mark>. The title is shown above, so don't repeat it.
          excerpt.innerHTML = r.meta.title ? trimTitle(r.excerpt, r.meta.title) : r.excerpt;
          li.append(a, meta, excerpt);
          return li;
        }),
      );
      more.hidden = total <= top.length;
      more.textContent = `Show all ${total} results`;
    }

    more.addEventListener('click', () => {
      limit = Infinity;
      // Keep focus in the list: the first newly shown result.
      const before = list.children.length;
      void run().then(() => list.children[before]?.querySelector('a')?.focus());
    });

    // Enter opens the first result.
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const first = list.querySelector<HTMLAnchorElement>('a');
      if (first) location.href = first.href;
    });
    input.addEventListener('focus', () => void load(), { once: true });
    input.addEventListener('input', () => {
      limit = PAGE;
      clearTimeout(timer);
      timer = window.setTimeout(run, 150);
    });
  }
</script>

<style>
  .search {
    margin: 1rem 0 1.5rem;
  }
  input {
    width: 100%;
    font: inherit;
    font-size: 1.05rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }
  input:focus {
    outline: 3px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  .more {
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    background: none;
    border: 0;
    padding: 0.5rem 0;
    color: var(--link);
    text-decoration: underline;
    cursor: pointer;
  }
  .status {
    margin: 0.4rem 0;
    min-height: 1.2em;
  }
  /* Nothing typed yet: no empty line under the box. */
  .status:empty {
    margin: 0;
    min-height: 0;
  }
  .results :global(li) {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }
  .results :global(.title) {
    font-weight: 700;
  }
  .results :global(.result-meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.1rem 0.5rem;
  }
  .results :global(.type) {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .results :global(p) {
    margin: 0.2rem 0 0;
  }
  .results :global(mark) {
    background: var(--warn-soft);
    color: inherit;
    padding: 0 0.1em;
  }
</style>
