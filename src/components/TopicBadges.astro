---
import { getSubjectData, url } from '../lib/content';
import { hasTopics } from '../lib/features';
import { PROGRESS_ICONS, PROGRESS_LABELS } from '../lib/progress-marks';

interface Props {
  subject: string;
  topics: string[];
  /** Show "Not on the AP exam" when there are no topics (only for a class with standards). */
  classOnlyBadge?: boolean;
}

const { subject, topics, classOnlyBadge = true } = Astro.props;
const data = getSubjectData(subject);
---

<div class="badges" data-pagefind-ignore>
  {topics.map((t) => {
    const s = data.progress.topics.get(t);
    return (
      <a
        class="badge topic"
        href={url(`${subject}/ap/${t}/`)}
        title={`${t} ${data.topics.get(t)?.title ?? ''}${s ? ` (${PROGRESS_LABELS[s].toLowerCase()})` : ''}`}
      >
        {s && (
          <>
            <span aria-hidden="true">{PROGRESS_ICONS[s]}</span>
            <span class="visually-hidden">({PROGRESS_LABELS[s]})</span>
          </>
        )}
        {t} {data.topics.get(t)?.title}
      </a>
    );
  })}
  {topics.length === 0 && classOnlyBadge && hasTopics(data) && <span class="badge not-ap">⊘ Not on the AP exam</span>}
</div>
