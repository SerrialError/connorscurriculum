---
// The Reference panel: the class's equation sheet and periodic table, opened from the header
// button (or R). Wide screens dock it on the right and keep the page usable beside it, so a
// practice question and the sheet are both in view; it stays open across pages until closed.
// Phones get a sheet from the bottom over the page.
// Its content isn't in every page: it's loaded from the reference page the first time it's needed
// (as soon as the button is pointed at or tapped), and kept for the browser tab.
import type { SubjectData } from '../../lib/registry';
import { url } from '../../lib/content';
// The sheet's styles too: a separate file, fetched only when the panel is used.
import sheetCss from '../../styles/reference.css?url';

interface Props {
  data: SubjectData;
  /**
   * Just the script, no panel: on the reference page, where it sets up the page's own periodic
   * table. One script for both keeps the table's code inside it rather than in a separate file
   * that every page would wait for.
   */
  scriptOnly?: boolean;
}

const { data, scriptOnly = false } = Astro.props;
const reference = data.reference!;
const hasTable = data.elements.length > 0;
const key = `study:${data.subject.id}:reference`;
const source = url(`${data.subject.id}/reference/`);
---

{!scriptOnly && (
<dialog class="ref-panel" id="ref-panel" aria-labelledby="ref-title" data-storage-key={key} data-source={source} data-css={sheetCss}>
  {/* Docked: drag the left edge to resize (or arrow keys on it). On phones the sheet's top bar is
      dragged instead (see the script). */}
  <div
    class="ref-resize"
    role="separator"
    aria-orientation="vertical"
    aria-label="Resize the reference panel"
    aria-controls="ref-panel"
    tabindex="0"
    title="Drag, or use ← and →, to resize. Double-click to reset."
    data-ref-resize
  ></div>
  <div class="ref-head" data-ref-head>
    {/* With tabs, they say what this is, so the heading is for screen readers only. */}
    <h2 id="ref-title" class:list={['ref-title', { 'visually-hidden': hasTable }]}>Reference</h2>
    {
      hasTable && (
        <div class="ref-tabs" role="tablist" aria-label="Reference">
          <button type="button" role="tab" id="ref-tab-eq" aria-controls="ref-eq" aria-selected="true" data-tab="eq">
            Equations
          </button>
          <button type="button" role="tab" id="ref-tab-pt" aria-controls="ref-pt" aria-selected="false" tabindex="-1" data-tab="pt" aria-label="Periodic table">
            <span class="long">Periodic table</span><span class="short" aria-hidden="true">Table</span>
          </button>
        </div>
      )
    }
    <span class="ref-spacer"></span>
    {/* The official version of whichever sheet is showing. */}
    {
      [
        { tab: 'eq', source: reference.official },
        ...(hasTable ? [{ tab: 'pt', source: reference.periodicTable! }] : []),
      ].map(({ tab, source }) => (
        <a class="ref-official" href={source.url} target="_blank" rel="noopener" data-for={tab} title={source.label} aria-label={`${source.label} (opens in a new tab)`}>
          <span class="long">Official </span>PDF
        </a>
      ))
    }
    <a class="ref-icon" href={url(`${data.subject.id}/reference/`)} title="Open as a full page" aria-label="Open the reference as a full page">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 4h5v5M20 4l-6 6M9 20H4v-5M4 20l6-6"></path>
      </svg>
    </a>
    <button type="button" class="ref-icon" data-ref-close aria-label="Close reference" title="Close (Esc)">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>
  <div class="ref-body" tabindex="-1">
    <section id="ref-eq" role={hasTable ? 'tabpanel' : undefined} aria-labelledby={hasTable ? 'ref-tab-eq' : 'ref-title'} data-panel="eq">
      <p class="muted small" data-ref-slot="eq">Loading…</p>
    </section>
    {
      hasTable && (
        <section id="ref-pt" role="tabpanel" aria-labelledby="ref-tab-pt" data-panel="pt">
          <p class="muted small" data-ref-slot="pt">Loading…</p>
        </section>
      )
    }
  </div>
</dialog>
)}

<!-- <head> (Base.astro) set html.ref-docked and data-ref-tab from the last page, so the layout is
     right from the first paint and CSS shows the right tab. Open the dialog to match, without
     moving focus (show() would). -->
<script is:inline>
  (() => {
    const d = document.getElementById('ref-panel');
    if (!d || !document.documentElement.classList.contains('ref-docked')) return;
    d.setAttribute('open', '');
    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = d.dataset.css;
    css.dataset.refCss = '';
    document.head.append(css);
    // Its content from an earlier page in this tab, so it doesn't flash "Loading…" (see loadContent).
    try {
      const saved = JSON.parse(sessionStorage.getItem('ref-content:' + d.dataset.source) || 'null');
      if (saved) for (const slot of d.querySelectorAll('[data-ref-slot]')) slot.outerHTML = saved[slot.dataset.refSlot] ?? slot.outerHTML;
    } catch {}
  })();
</script>

<script>
  import { isTypingTarget } from '../../lib/keyboard';
  import { initPeriodicTable } from '../../lib/periodic-table-ui';

  // The reference page's own table (no panel there).
  document.querySelectorAll<HTMLElement>('main [data-periodic-table]').forEach(initPeriodicTable);

  const panel = document.getElementById('ref-panel') as HTMLDialogElement | null;
  if (panel) {
    const root = document.documentElement;
    const key = panel.dataset.storageKey!;
    const wide = matchMedia('(min-width: 64rem)');
    const openers = () => [...document.querySelectorAll<HTMLButtonElement>('[data-ref-open]')];
    const tabs = [...panel.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    let returnFocus: HTMLElement | null = null;

    /**
     * Fill the panel from the reference page's [data-ref-content] parts, once. Kept in
     * sessionStorage, so later pages in this tab show it at once (the inline script above).
     */
    const contentKey = `ref-content:${panel.dataset.source}`;
    let content: Promise<void> | null = null;
    /** The periodic table's search and keys, on the panel's copy. */
    const startTable = () => panel!.querySelectorAll<HTMLElement>('[data-periodic-table]').forEach(initPeriodicTable);
    function loadContent(): Promise<void> {
      if (!document.querySelector('link[data-ref-css]')) {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = panel!.dataset.css!;
        css.dataset.refCss = '';
        document.head.append(css);
      }
      // Filled already, from an earlier page in this tab (the inline script above).
      if (!panel!.querySelector('[data-ref-slot]')) {
        content ??= Promise.resolve(startTable());
        return content;
      }
      content ??= fetch(panel!.dataset.source!)
        .then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.text();
        })
        .then((html) => {
          const page = new DOMParser().parseFromString(html, 'text/html');
          const parts: Record<string, string> = {};
          for (const slot of panel!.querySelectorAll<HTMLElement>('[data-ref-slot]')) {
            const part = page.querySelector(`[data-ref-content="${slot.dataset.refSlot}"]`);
            if (!part) throw new Error('missing part');
            parts[slot.dataset.refSlot!] = part.outerHTML;
            slot.outerHTML = part.outerHTML;
          }
          try {
            sessionStorage.setItem(contentKey, JSON.stringify(parts));
          } catch {}
          startTable();
        })
        .catch(() => {
          content = null; // try again next time
          for (const slot of panel!.querySelectorAll<HTMLElement>('[data-ref-slot]')) {
            slot.innerHTML = `Couldn't load this. <a href="${panel!.dataset.source}">Open the reference page</a> instead.`;
          }
        });
      return content;
    }
    // Start loading as soon as someone heads for the button, so it's there when the panel opens.
    for (const b of document.querySelectorAll<HTMLElement>('[data-ref-open]')) {
      for (const ev of ['pointerenter', 'touchstart', 'focus']) b.addEventListener(ev, () => void loadContent(), { once: true, passive: true });
    }
    if (panel.open) void loadContent();

    /** width: the docked panel's, in px. height: the phone sheet's, as a share of the screen. */
    type Saved = { open?: boolean; tab?: 'eq' | 'pt'; width?: number | null; height?: number | null };
    // localStorage directly, not lib/storage: one less file for every page to fetch.
    const save = (s: Saved) => {
      try {
        localStorage.setItem(key, JSON.stringify({ ...JSON.parse(localStorage.getItem(key) || '{}'), ...s }));
      } catch {}
    };
    const sync = () => {
      for (const b of openers()) b.setAttribute('aria-expanded', String(panel.open));
    };

    /**
     * Docked, focus stays where it was, so practice shortcuts (A–D, arrows) keep working beside
     * it. The phone sheet is modal, so focus moves into it, onto the scrolling sheet.
     */
    function open() {
      void loadContent();
      const before = document.activeElement as HTMLElement | null;
      if (panel!.open) panel!.close();
      if (wide.matches) {
        panel!.show();
        root.classList.add('ref-docked');
        // show() focuses the first control in the panel (a tab), which then shows a focus ring
        // nobody asked for. Put focus back where it was, or nowhere.
        if (before && before !== document.body) before.focus({ preventScroll: true });
        else (document.activeElement as HTMLElement | null)?.blur();
      } else {
        root.classList.remove('ref-docked');
        panel!.showModal();
        panel!.querySelector<HTMLElement>('.ref-body')!.focus();
      }
      save({ open: true });
      sync();
    }

    function close() {
      panel!.close();
    }

    panel.addEventListener('close', () => {
      // Closed only to reopen in the other mode (crossing the docking size): this event arrives
      // after it's open again, so there's nothing to undo.
      if (panel.open) return;
      root.classList.remove('ref-docked');
      save({ open: false });
      sync();
      returnFocus?.focus();
      returnFocus = null;
    });

    function toggle(from: HTMLElement | null) {
      if (panel!.open) return close();
      returnFocus = from;
      open();
    }

    for (const b of openers()) b.addEventListener('click', () => toggle(b));
    panel.querySelector('[data-ref-close]')!.addEventListener('click', close);

    // Esc closes it from anywhere (a docked panel isn't modal, so the browser doesn't do this for
    // it), unless it's clearing the element search or closing another dialog such as search.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !panel.open || e.defaultPrevented) return;
      const t = e.target as HTMLElement;
      if (t.matches?.('input[type="search"]:not(:placeholder-shown)')) return;
      if (t.closest?.('dialog[open]') && !panel.contains(t)) return;
      e.preventDefault();
      close();
    });

    // Tapping the dimmed page around the phone sheet closes it.
    panel.addEventListener('click', (e) => {
      if (e.target === panel && !wide.matches) close();
    });

    // R, except while typing: opens the panel; with it docked open and focus on the page, moves
    // into it (it comes last in tab order); from inside it, closes it.
    document.addEventListener('keydown', (e) => {
      if (e.key.toLowerCase() !== 'r' || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      const t = e.target as HTMLElement;
      const inside = panel.contains(t);
      if (inside ? t.closest('input, textarea, select') : isTypingTarget(t)) return;
      e.preventDefault();
      if (panel.open && !inside) {
        returnFocus = t;
        (tabs.find((x) => x.getAttribute('aria-selected') === 'true') ?? panel.querySelector<HTMLElement>('.ref-body'))!.focus();
        return;
      }
      toggle(panel.open ? null : (document.activeElement as HTMLElement | null));
    });

    // Crossing the size where it docks: reopen it in the other mode.
    wide.addEventListener('change', () => {
      if (panel.open) open();
    });

    /** Tabs are shown by CSS from html[data-ref-tab]; this keeps the tab buttons in step. */
    function selectTab(tab: HTMLButtonElement, focus: boolean) {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      }
      root.dataset.refTab = tab.dataset.tab;
      save({ tab: tab.dataset.tab as Saved['tab'] });
      if (focus) tab.focus();
    }
    const startTab = tabs.find((t) => t.dataset.tab === (root.dataset.refTab ?? 'eq'));
    if (startTab) selectTab(startTab, false);
    for (const t of tabs) {
      t.addEventListener('click', () => selectTab(t, false));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        e.preventDefault();
        const i = tabs.indexOf(t);
        selectTab(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length]!, true);
      });
    }

    /*
     * Resizing. Docked: the left edge sets the width, which the page makes room for. The CSS
     * (--ref-w) keeps any width between 22rem and leaving the page 36rem, so a size saved on a
     * big screen still fits a smaller one. Phones: dragging the sheet's top bar sets its height,
     * and dragging it most of the way down closes it.
     */
    const rem = () => parseFloat(getComputedStyle(root).fontSize);
    const widthLimits = () => [22 * rem(), Math.max(22 * rem(), innerWidth - 36 * rem())] as const;
    const handle = panel.querySelector<HTMLElement>('[data-ref-resize]')!;
    function describeWidth() {
      const [min, max] = widthLimits();
      const w = panel!.getBoundingClientRect().width;
      handle.setAttribute('aria-valuemin', String(Math.round(min)));
      handle.setAttribute('aria-valuemax', String(Math.round(max)));
      handle.setAttribute('aria-valuenow', String(Math.round(w)));
      handle.setAttribute('aria-valuetext', `${Math.round((w / innerWidth) * 100)}% of the window`);
    }
    function setWidth(px: number | null, keep: boolean) {
      if (px === null) root.style.removeProperty('--ref-user-w');
      else {
        const [min, max] = widthLimits();
        root.style.setProperty('--ref-user-w', `${Math.round(Math.min(max, Math.max(min, px)))}px`);
      }
      if (keep) save({ width: px === null ? null : Math.round(panel!.getBoundingClientRect().width) });
      describeWidth();
    }
    handle.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      e.preventDefault();
      handle.setPointerCapture(e.pointerId);
      root.classList.add('ref-resizing');
      const startX = e.clientX;
      const startW = panel!.getBoundingClientRect().width;
      const move = (m: PointerEvent) => setWidth(startW + startX - m.clientX, false);
      const end = () => {
        root.classList.remove('ref-resizing');
        handle.removeEventListener('pointermove', move);
        setWidth(panel!.getBoundingClientRect().width, true);
      };
      handle.addEventListener('pointermove', move);
      handle.addEventListener('lostpointercapture', end, { once: true });
    });
    handle.addEventListener('dblclick', () => setWidth(null, true));
    handle.addEventListener('keydown', (e) => {
      const w = panel!.getBoundingClientRect().width;
      const [min, max] = widthLimits();
      const to = { ArrowLeft: w + 32, ArrowRight: w - 32, Home: min, End: max, Enter: null }[e.key];
      if (to === undefined) return;
      e.preventDefault();
      setWidth(to, true);
    });
    panel.addEventListener('toggle', describeWidth);
    addEventListener('resize', describeWidth, { passive: true });

    const head = panel.querySelector<HTMLElement>('[data-ref-head]')!;
    head.addEventListener('pointerdown', (e) => {
      if (wide.matches || e.button !== 0 || (e.target as HTMLElement).closest('a, button')) return;
      const startY = e.clientY;
      const startH = panel!.getBoundingClientRect().height;
      head.setPointerCapture(e.pointerId);
      // While dragging, the sheet follows the finger all the way down (the 40% floor is applied
      // on release), and fades once letting go would close it.
      root.classList.add('ref-resizing', 'ref-sheet-drag');
      let share = startH / innerHeight;
      const move = (m: PointerEvent) => {
        share = Math.max(0.05, Math.min(0.94, (startH + startY - m.clientY) / innerHeight));
        root.style.setProperty('--ref-user-h', `${share * 100}dvh`);
        panel!.classList.toggle('will-close', share < 0.3);
      };
      const end = () => {
        root.classList.remove('ref-resizing', 'ref-sheet-drag');
        panel!.classList.remove('will-close');
        head.removeEventListener('pointermove', move);
        if (Math.abs(share * innerHeight - startH) < 4) return; // a tap, not a drag
        if (share < 0.3) {
          // Dragged away: close, and open at the earlier height next time.
          root.style.setProperty('--ref-user-h', `${(startH / innerHeight) * 100}dvh`);
          return close();
        }
        share = Math.max(0.4, share);
        root.style.setProperty('--ref-user-h', `${share * 100}dvh`);
        save({ height: Math.round(share * 100) / 100 });
      };
      head.addEventListener('pointermove', move);
      head.addEventListener('lostpointercapture', end, { once: true });
    });
    sync();
  }
</script>

<style is:global>
  /* Docked: the page makes room for the panel instead of sitting under it. Both tabs use the same
     width, so switching never re-wraps the page; the periodic table fits itself to it. The width is
     the reader's (dragged, --ref-user-w) or a default that grows with the screen, and always leaves
     the page at least 36rem. */
  @media (min-width: 64rem) {
    html {
      --ref-w: clamp(22rem, var(--ref-user-w, clamp(24rem, 44vw, 72rem)), max(22rem, 100vw - 36rem));
    }
    html.ref-docked body {
      padding-right: var(--ref-w);
    }
  }
  /* While dragging a size: no text selection, and the cursor stays the resize one. */
  html.ref-resizing,
  html.ref-resizing * {
    user-select: none;
    cursor: col-resize !important;
  }
  @media (max-width: 63.99rem) {
    html.ref-resizing,
    html.ref-resizing * {
      cursor: grabbing !important;
    }
  }
  /* The open tab, from the last page too (set in <head>). */
  html:not([data-ref-tab='pt']) #ref-pt,
  html[data-ref-tab='pt'] #ref-eq,
  html:not([data-ref-tab='pt']) .ref-official[data-for='pt'],
  html[data-ref-tab='pt'] .ref-official[data-for='eq'] {
    display: none;
  }
  /* The phone sheet is modal: the page behind it doesn't scroll. */
  html:has(.ref-panel:modal) {
    overflow: hidden;
  }
</style>

<style>
  .ref-panel {
    position: fixed;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--text);
    background: var(--bg);
    display: none;
    flex-direction: column;
    overflow: visible;
    /* Phones: a sheet from the bottom; drag its top bar to change the height. */
    inset: auto 0 0 0;
    width: 100%;
    max-width: 100%;
    height: clamp(40dvh, var(--ref-user-h, 88dvh), 94dvh);
    max-height: 100%;
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -8px 30px rgb(0 0 0 / 0.18);
    z-index: 40;
    container-type: inline-size;
  }
  .ref-panel[open] {
    display: flex;
  }
  /* Dragging the phone sheet: it follows the finger below its usual 40% floor, and fades when
     letting go would close it. */
  :global(html.ref-sheet-drag) .ref-panel {
    height: min(var(--ref-user-h), 94dvh);
  }
  .ref-panel.will-close {
    opacity: 0.6;
  }
  .ref-panel::backdrop {
    background: rgb(0 0 0 / 0.35);
  }
  @media (min-width: 64rem) {
    .ref-panel {
      inset: 0 0 0 auto;
      width: var(--ref-w);
      height: 100dvh;
      border-radius: 0;
      border-left: 1px solid var(--border);
      box-shadow: -4px 0 18px rgb(0 0 0 / 0.06);
    }
  }

  /* The docked panel's left edge: a wide target for dragging, a line and grip where you can see it. */
  .ref-resize {
    display: none;
  }
  @media (min-width: 64rem) {
    .ref-resize {
      display: block;
      position: absolute;
      inset: 0 auto 0 0;
      z-index: 1;
      width: 12px;
      translate: -6px 0;
      cursor: col-resize;
      touch-action: none;
    }
    .ref-resize::before {
      content: '';
      position: absolute;
      inset: 0 auto 0 5px;
      width: 2px;
      background: transparent;
      transition: background 0.15s;
    }
    .ref-resize::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 3px;
      width: 6px;
      height: 3rem;
      translate: 0 -50%;
      border-radius: 3px;
      background: var(--muted);
      opacity: 0.55;
      transition: background 0.15s;
    }
    .ref-resize:hover::before,
    .ref-resize:focus-visible::before,
    :global(html.ref-resizing) .ref-resize::before {
      background: var(--accent);
    }
    .ref-resize:hover::after,
    .ref-resize:focus-visible::after,
    :global(html.ref-resizing) .ref-resize::after {
      background: var(--accent);
      opacity: 1;
    }
    .ref-resize:focus-visible {
      outline: none;
    }
  }

  .ref-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.75rem 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  /* Phones: the head is the sheet's handle, with the usual grabber bar on top. */
  @media (max-width: 63.99rem) {
    .ref-panel {
      border-top: 1px solid var(--border);
    }
    .ref-head {
      padding-top: 1.15rem;
      border-radius: 16px 16px 0 0;
      touch-action: none;
      cursor: grab;
    }
    .ref-head::before {
      content: '';
      position: absolute;
      top: 0.45rem;
      left: 50%;
      width: 2.5rem;
      height: 4px;
      translate: -50% 0;
      border-radius: 2px;
      background: var(--border);
    }
  }
  .ref-title {
    margin: 0;
    font-size: 1rem;
  }
  /* The tabs: a segmented control, the open one raised. */
  .ref-tabs {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 10px;
    background: var(--surface-2);
  }
  .ref-tabs button {
    min-height: 2.25rem;
    padding: 0.25rem 0.9rem;
    white-space: nowrap;
    border: 0;
    border-radius: 7px;
    background: none;
    color: var(--text-2);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .ref-tabs button:hover {
    color: var(--text);
  }
  .ref-tabs button[aria-selected='true'] {
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 0 0 1px var(--border);
  }
  .ref-tabs button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .ref-spacer {
    flex: 1;
  }
  .ref-tabs .short {
    display: none;
  }
  .ref-official {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--pill);
    background: var(--surface);
    color: var(--text-2);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }
  .ref-official:hover {
    background: var(--surface-2);
    color: var(--text);
