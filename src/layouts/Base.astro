---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getSubjectData, url } from '../lib/content';
import { SITE_DESCRIPTION, SITE_NAME } from '../site';

interface Props {
  title: string;
  description?: string;
  /** Subject id; adds the subject nav. */
  subject?: string;
  /** Pagefind indexes only pages that set this. */
  searchable?: boolean;
  /** Extra Pagefind metadata shown with search results. */
  searchMeta?: { chapter?: string };
}

const { title, description = SITE_DESCRIPTION, subject, searchable = false, searchMeta = {} } = Astro.props;
const subjectData = subject ? getSubjectData(subject) : undefined;
const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const path = Astro.url.pathname;
const nav = subject
  ? [
      { href: url(`${subject}/chapters/`), label: 'Chapters' },
      { href: url(`${subject}/ap/`), label: 'AP topics' },
      { href: url(`${subject}/practice/`), label: 'Practice' },
    ]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url()}>{SITE_NAME}</a>
        {subjectData && (
          <a class="subject" href={url(`${subject}/`)}>
            {subjectData.subject.name}
          </a>
        )}
        <span class="spacer"></span>
        <ThemeToggle />
      </div>
      {nav.length > 0 && (
        <nav class="wrap subnav" aria-label="Subject">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
              {n.label}
            </a>
          ))}
        </nav>
      )}
    </header>
    <main id="main" class="wrap" data-pagefind-body={searchable ? '' : undefined}>
      {searchable && (
        <div hidden>
          <span data-pagefind-meta="title">{title}</span>
          {subjectData && <span data-pagefind-meta="subject">{subjectData.subject.name}</span>}
          {searchMeta.chapter && <span data-pagefind-meta="chapter">{searchMeta.chapter}</span>}
        </div>
      )}
      <slot />
    </main>
    <footer class="site-footer wrap small muted">
      <p>
        Written by students. Not affiliated with or endorsed by College Board or Pearson. AP® is a registered trademark of
        College Board.
      </p>
    </footer>
  </body>
</html>

<style>
  .skip:focus {
    position: static !important;
    width: auto;
    height: auto;
    clip: auto;
    padding: 0.5rem;
  }
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
  }
  .brand {
    white-space: nowrap;
    font-weight: 800;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .subject {
    color: var(--text-2);
    text-decoration: none;
    font-weight: 600;
    padding-left: 0.75rem;
    border-left: 1px solid var(--border);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .spacer {
    flex: 1;
  }
  .subnav {
    display: flex;
    gap: 0.1rem;
    margin-left: -0.55rem;
    overflow-x: auto;
    padding-bottom: 0.4rem;
  }
  .subnav a {
    padding: 0.3rem 0.55rem;
    border-radius: 6px;
    color: var(--text-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .subnav a:hover {
    background: var(--surface-2);
  }
  .subnav a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--link);
  }
  main {
    padding-bottom: 3rem;
  }
  @media (max-width: 420px) {
    .subnav a {
      font-size: 0.9rem;
      padding: 0.3rem 0.45rem;
    }
  }
  .site-footer {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    padding-bottom: 2rem;
  }
</style>
