---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Search from '../components/Search.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getSubjectData, url } from '../lib/content';
import { loadRegistry } from '../lib/registry';
import { SITE_DESCRIPTION, SITE_NAME } from '../site';

interface Props {
  title: string;
  description?: string;
  /** Subject id; adds the subject nav. */
  subject?: string;
  /** Pagefind indexes only pages that set this. */
  searchable?: boolean;
  /** Extra Pagefind metadata shown with search results. */
  searchMeta?: { chapter?: string };
  /** Nav item to highlight, when it isn't the one the URL belongs to (e.g. "Tests"). */
  section?: string;
}

const { title, description = SITE_DESCRIPTION, subject, searchable = false, searchMeta = {}, section } = Astro.props;
const subjectData = subject ? getSubjectData(subject) : undefined;
const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const path = Astro.url.pathname;
// Each nav item also owns the pages under it: lessons belong to Chapters. Pass `section` to
// highlight a different item (a test review sheet is a lesson, but belongs to Tests).
const nav: NavItem[] = subject
  ? [
      { href: url(`${subject}/`), label: 'Home', exact: true },
      { href: url(`${subject}/chapters/`), label: 'Chapters', also: [url(`${subject}/lessons/`)] },
      { href: url(`${subject}/tests/`), label: 'Tests' },
      { href: url(`${subject}/practice/`), label: 'Practice' },
      { href: url(`${subject}/ap/`), label: 'AP topics' },
      { href: url(`${subject}/frqs/`), label: 'Past FRQs', short: 'FRQs' },
    ]
  : [];
type NavItem = { href: string; label: string; exact?: boolean; also?: string[]; short?: string };
const matches = (n: NavItem) =>
  n.exact ? path === n.href : [n.href, ...(n.also ?? [])].some((h) => path.startsWith(h));
const isCurrent = (n: NavItem) => (section ? n.label === section : matches(n));
const onHome = subject !== undefined && path === url(`${subject}/`);
// One class: the site's home is that class ("/" redirects there), and there's no class list to link to.
const subjectIds = [...loadRegistry().keys()];
const siteHome = subjectIds.length === 1 ? url(`${subjectIds[0]}/`) : url();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class:list={['brand', { 'has-subject': !!subjectData }]} href={siteHome}>{SITE_NAME}</a>
        {subjectData && (
          <a class="subject" href={url(`${subject}/`)} aria-current={onHome ? 'page' : undefined}>
            <svg class="home-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 11 12 3l9 8"></path>
              <path d="M5 9.5V21h14V9.5"></path>
            </svg>
            {subjectData.subject.name}
          </a>
        )}
        <span class="spacer"></span>
        <button class="icon-button search-open" type="button" aria-haspopup="dialog" aria-keyshortcuts="/" title="Search (press /)">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="m15.5 15.5 5 5"></path>
          </svg>
          <span class="search-label">Search</span>
        </button>
        <ThemeToggle />
      </div>
      {nav.length > 0 && (
        <nav class="wrap subnav" aria-label={subjectData?.subject.name}>
          {nav.map((n) => (
            <a href={n.href} class:list={{ 'nav-home': n.exact }} aria-current={isCurrent(n) ? 'page' : undefined}>
              {n.short ? (
                <>
                  <span class="long">{n.label}</span>
                  <span class="short">{n.short}</span>
                </>
              ) : (
                n.label
              )}
            </a>
          ))}
        </nav>
      )}
    </header>
    <dialog class="search-dialog" aria-label="Search">
      <div class="search-dialog-head">
        <strong>Search{subjectData && ` ${subjectData.subject.name}`}</strong>
        <button class="icon-button search-close" type="button" aria-keyshortcuts="Escape">Close <kbd>Esc</kbd></button>
      </div>
      <Search id="header-search" placeholder="Lessons, chapters, AP topics…" />
    </dialog>
    <main id="main" class="wrap" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      {searchable && (
        <div hidden data-pagefind-ignore>
          <span data-pagefind-meta="title">{title}</span>
          {subjectData && <span data-pagefind-meta="subject">{subjectData.subject.name}</span>}
          {searchMeta.chapter && <span data-pagefind-meta="chapter">{searchMeta.chapter}</span>}
        </div>
      )}
      <slot />
    </main>
    <footer class="site-footer wrap small muted">
      <p>
        {subjectIds.length > 1 && <><a href={url()}>All classes</a> · </>}<a href={url('admin/')}>Write a lesson</a>
      </p>
      <p>
        Not affiliated with or endorsed by College Board or Pearson. AP® is a registered trademark of College Board.
      </p>
    </footer>
    <script>
      const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
      const input = dialog.querySelector<HTMLInputElement>('input')!;
      const open = () => {
        if (dialog.open) return;
        dialog.showModal();
        input.focus();
        input.select();
      };
      document.querySelector('.search-open')!.addEventListener('click', open);
      dialog.querySelector('.search-close')!.addEventListener('click', () => dialog.close());
      // Escape closes right away (a search box would otherwise use the first Escape to clear itself).
      dialog.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          dialog.close();
        }
      });
      // Click on the backdrop closes the dialog.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
      // "/" opens search, unless the user is typing somewhere.
      document.addEventListener('keydown', (e) => {
        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
        const t = e.target as HTMLElement;
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        e.preventDefault();
        open();
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 0.5rem;
    top: -3rem;
    z-index: 10;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
  }
  .skip:focus {
    top: 0.5rem;
  }
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.25rem;
  }
  .brand {
    white-space: nowrap;
    font-weight: 800;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .subject {
    color: var(--text-2);
    text-decoration: none;
    font-weight: 600;
    padding-left: 0.6rem;
    border-left: 1px solid var(--border);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .brand:hover,
  .subject:hover {
    color: var(--link);
  }
  .home-icon,
  .subnav .short {
    display: none;
  }
  .spacer {
    flex: 1;
  }
  .icon-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.1rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-2);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .icon-button:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .subnav {
    display: flex;
    gap: 0.15rem;
    /* Line up the first link's text with the content: page padding minus link padding. */
    padding-left: calc(1rem - 0.6rem);
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.45rem;
  }
  .subnav a {
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    color: var(--text-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .subnav a:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .subnav a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--link);
  }
  main {
    padding-bottom: 3rem;
  }
  main:focus {
    outline: none;
  }
  /* Narrow screens: the subject name stands in for the site name, and the nav links shrink to fit. */
  @media (max-width: 520px) {
    .brand.has-subject {
      display: none;
    }
    /* The subject name is the home link here (the nav's Home is hidden), so make it look like one. */
    .subject {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: var(--text);
      font-weight: 800;
      border-left: 0;
      padding: 0.25rem 0.5rem 0.25rem 0.4rem;
      margin-left: -0.4rem;
      border-radius: 8px;
    }
    .subject[aria-current='page'] {
      background: var(--accent-soft);
      color: var(--link);
    }
    .home-icon {
      display: block;
      flex: none;
    }
    .search-label {
      display: none;
    }
    .icon-button.search-open {
      padding: 0.3rem 0.55rem;
    }
    .subnav {
      gap: 0;
      padding-left: calc(1rem - 0.4rem);
    }
    .subnav a {
      font-size: 0.875rem;
      padding: 0.35rem 0.4rem;
    }
    /* The subject name in the bar is the home link here. */
    .subnav a.nav-home,
    .subnav .long {
      display: none;
    }
    .subnav .short {
      display: inline;
    }
  }
  /* The smallest phones: tighter links so all five fit without scrolling. */
  @media (max-width: 380px) {
    .subnav {
      padding-left: calc(1rem - 0.3rem);
    }
    .subnav a {
      font-size: 0.82rem;
      padding-inline: 0.28rem;
    }
  }
  .search-dialog {
    width: min(40rem, calc(100vw - 1.5rem));
    max-height: min(80vh, 40rem);
    margin: 8vh auto auto;
    padding: 1rem 1.1rem 0.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.3);
  }
  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.35);
  }
  .search-close kbd {
    font: inherit;
    font-size: 0.72rem;
    padding: 0 0.3rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--muted);
  }
  @media (hover: none), (pointer: coarse) {
    .search-close kbd {
      display: none;
    }
  }
  .search-dialog-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .search-dialog :global(.search) {
    margin: 0.75rem 0 0.5rem;
  }
  .site-footer {
    text-align: center;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    padding-bottom: 2rem;
  }
  .site-footer p {
    margin: 0.4rem 0;
  }
</style>
