---
import LessonList from '../../../components/LessonList.astro';
import ProgressMark from '../../../components/ProgressMark.astro';
import Base from '../../../layouts/Base.astro';
import { coverage, getLessons, getQuestions, getSubjectData, practiceHref, subjectIds, url } from '../../../lib/content';

export function getStaticPaths() {
  return subjectIds().flatMap((subject) =>
    [...getSubjectData(subject).topics.keys()].map((topicId) => ({ params: { subject, topicId } })),
  );
}

const { subject, topicId } = Astro.params;
const data = getSubjectData(subject);
const topic = data.topics.get(topicId)!;
const unit = data.ced.units.find((u) => u.id === topic.unitId)!;
const c = coverage(data, await getLessons(subject), await getQuestions(subject)).get(topicId)!;
// Chapters that teach this topic (chapters.json), plus any other chapter with content tagged with it.
const teaching = data.topicChapters.get(topicId) ?? [];
const alsoTagged = c.chapters.filter((n) => !teaching.includes(n));
const flat = unit.topics.map((t) => t.id);
const i = flat.indexOf(topicId);
const prev = flat[i - 1];
const next = flat[i + 1];
---

<Base title={`${topicId} ${topic.title}`} subject={subject} searchable>
  <p class="breadcrumbs">
    <a href={url(`${subject}/ap/`)}>{data.subject.standardsName}</a> / <a href={url(`${subject}/ap/#unit-${unit.id}`)}>Unit {unit.id}: {unit.title}</a>
  </p>
  <h1>{topicId} {topic.title}</h1>
  {data.progress.topics.has(topicId) && (
    <p class="status">
      <ProgressMark status={data.progress.topics.get(topicId) ?? null} doneLabel="Covered in class" />
      {data.progress.notes.get(topicId) && <span class="small muted">{data.progress.notes.get(topicId)}</span>}
    </p>
  )}

  <h2>Textbook chapters</h2>
  {teaching.length > 0 ? (
    <ul class="plain-list chapters">
      {teaching.map((n) => (
        <li>
          <ProgressMark status={data.progress.chapters.has(n) ? 'done' : null} compact />
          <a href={url(`${subject}/chapters/${n}/`)}>Chapter {n}: {data.chapterMap.get(n)?.title}</a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="muted">No chapter in chapters.json lists this topic yet.</p>
  )}
  {alsoTagged.length > 0 && (
    <p class="small muted">
      Also tagged in lessons or questions from Chapter{alsoTagged.length > 1 ? 's' : ''} {alsoTagged.join(', ')}.
    </p>
  )}

  <div class="actions">
    <a class="button" href={practiceHref(subject, { topic: [topicId] })}>Practice this topic ({c.questions})</a>
  </div>

  <h2>Lessons</h2>
  <LessonList lessons={c.lessons} showChapter />

  <nav class="pager small" aria-label="Topics">
    {prev ? <a href={url(`${subject}/ap/${prev}/`)}>← {prev}</a> : <span></span>}
    {next && <a href={url(`${subject}/ap/${next}/`)}>{next} →</a>}
  </nav>
</Base>

<style>
  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .chapters li {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.2rem 0;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    margin-top: 2rem;
  }
</style>
