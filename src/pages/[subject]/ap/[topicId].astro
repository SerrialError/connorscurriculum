---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FrqCard from '../../../components/FrqCard.astro';
import LessonList from '../../../components/LessonList.astro';
import ProgressMark from '../../../components/ProgressMark.astro';
import Base from '../../../layouts/Base.astro';
import { coverage, getLessons, getQuestions, getSubjectData, pastFrqLinks, practiceHref, practiceStart, subjectIds, url } from '../../../lib/content';
import { frqCountLabel, matchFrqs } from '../../../lib/frqs';
import { plural } from '../../../lib/text';

export function getStaticPaths() {
  return subjectIds().flatMap((subject) =>
    [...getSubjectData(subject).topics.keys()].map((topicId) => ({ params: { subject, topicId } })),
  );
}

const { subject, topicId } = Astro.params;
const data = getSubjectData(subject);
const topic = data.topics.get(topicId)!;
const unit = data.ced.units.find((u) => u.id === topic.unitId)!;
const c = coverage(data, await getLessons(subject), await getQuestions(subject)).get(topicId)!;
// Chapters that teach this topic (chapters.json), plus any other chapter with content tagged with it.
const teaching = data.topicChapters.get(topicId) ?? [];
const alsoTagged = c.chapters.filter((n) => !teaching.includes(n));
const frqMatches = matchFrqs(pastFrqLinks(data), new Set([topicId]));
const status = data.progress.topics.get(topicId) ?? null;
const notes = data.progress.notes.get(topicId) ?? [];
const gap = data.textbookGaps.topics.get(topicId);
// Previous/next across the whole CED, so the last topic of a unit leads into the next unit.
const flat = [...data.topics.keys()];
const i = flat.indexOf(topicId);
const prev = flat[i - 1];
const next = flat[i + 1];
---

<Base title={`${topicId} ${topic.title}`} subject={subject} searchable searchMeta={{ type: 'AP topic' }}>
  <Breadcrumbs
    items={[
      { href: url(`${subject}/ap/`), label: 'AP topics' },
      { href: url(`${subject}/ap/#unit-${unit.id}`), label: `Unit ${unit.id}: ${unit.title}` },
    ]}
  />
  <h1>{topicId} {topic.title}</h1>
  {(status || notes.length > 0) && (
    <div class="status">
      <ProgressMark status={status} />
      {notes.map((note) => <p class="small muted">{note}</p>)}
    </div>
  )}

  {gap && (
    <aside class="callout not-on-ap gap" aria-label="Textbook coverage">
      <p class="callout-title">⚑ {gap.coverage === 'missing' ? 'The textbook doesn’t teach this' : 'The textbook covers this thinly'}</p>
      <div class="callout-body">
        <p><strong>In the book:</strong> {gap.book}</p>
        <p><strong>Learn elsewhere:</strong> {gap.learn}</p>
        <p class="small"><a href={url(`${subject}/ap/#textbook-gaps`)}>Other topics the textbook covers thinly</a></p>
      </div>
    </aside>
  )}

  <div class="actions" data-pagefind-ignore>
    {c.questions > 0 ? (
      <>
        <a class="button" href={practiceStart(subject, { topic: [topicId] }, c.questions).href}>{practiceStart(subject, { topic: [topicId] }, c.questions).label}</a>
        <a class="button secondary" href={practiceHref(subject, { topic: [topicId] })}>Pick your own set ({plural(c.questions, 'question')})</a>
      </>
    ) : (
      <p class="small muted">No practice questions on this topic yet.{frqMatches.length > 0 && ' Try the past AP FRQs below.'}</p>
    )}
  </div>

  <h2>Lessons</h2>
  <LessonList lessons={c.lessons} showChapter grouped empty="No lessons on this topic yet." />

  <h2>Textbook chapters</h2>
  {teaching.length > 0 ? (
    <ul class="plain-list chapters">
      {teaching.map((n) => (
        <li>
          <ProgressMark status={data.progress.chapters.has(n) ? 'done' : null} compact doneLabel="Finished in class" />
          <a href={url(`${subject}/chapters/${n}/`)}>Chapter {n}: {data.chapterMap.get(n)?.title}</a>
          {data.progress.current.includes(n) && <span class="badge now">Now in class</span>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="muted">No chapter in chapters.json lists this topic yet.</p>
  )}
  {alsoTagged.length > 0 && (
    <p class="small muted">
      Also tagged in lessons or questions from Chapter{alsoTagged.length > 1 ? 's' : ''} {alsoTagged.join(', ')}.
    </p>
  )}

  {/* FRQ titles mention other topics; keep them out of this page's search entry. */}
  <section data-pagefind-ignore="all">
    <h2>Past AP FRQs</h2>
    {frqMatches.length > 0 ? (
      <>
        <p class="small muted">
          {frqCountLabel(frqMatches)} on this topic.
          Grade yourself with the scoring guidelines.
        </p>
        <div class="stack">
          {frqMatches.map((m) => <FrqCard subject={subject} frq={m.frq} matched={m.parts} />)}
        </div>
      </>
    ) : (
      <p class="muted">No released FRQ parts on this topic in the years listed.</p>
    )}
  </section>

  <nav class="pager" aria-label="Topics">
    {prev ? (
      <a href={url(`${subject}/ap/${prev}/`)}><span class="small muted">← Previous</span>{prev} {data.topics.get(prev)!.title}</a>
    ) : <span></span>}
    {next && (
      <a class="next" href={url(`${subject}/ap/${next}/`)}><span class="small muted">Next →</span>{next} {data.topics.get(next)!.title}</a>
    )}
  </nav>
</Base>

<style>
  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: center;
  }
  .status p {
    margin: 0;
  }
  .gap p {
    margin: 0.3rem 0 0;
  }
  .chapters li {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.2rem 0;
  }
  .badge.now {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: transparent;
  }
</style>
