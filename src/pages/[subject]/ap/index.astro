---
import ProgressMark from '../../../components/ProgressMark.astro';
import Base from '../../../layouts/Base.astro';
import { coverage, getLessons, getQuestions, getSubjectData, pastFrqLinks, subjectPaths, url } from '../../../lib/content';
import { matchFrqs } from '../../../lib/frqs';

export const getStaticPaths = subjectPaths;

const { subject } = Astro.params;
const data = getSubjectData(subject);
const cov = coverage(data, await getLessons(subject), await getQuestions(subject));
const { progress } = data;
const statusOf = (id: string) => progress.topics.get(id) ?? null;
const count = (ids: string[], status: ReturnType<typeof statusOf>) => ids.filter((id) => statusOf(id) === status).length;
const allIds = [...data.topics.keys()];
const frqs = pastFrqLinks(data);
const frqCount = (id: string) => matchFrqs(frqs, new Set([id])).length;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
/** "1 lesson · 3 FRQs", leaving out zero counts. */
const counts = (id: string) => {
  const c = cov.get(id)!;
  return [
    c.lessons.length && plural(c.lessons.length, 'lesson'),
    c.questions && plural(c.questions, 'question'),
    frqCount(id) && plural(frqCount(id), 'FRQ'),
  ]
    .filter(Boolean)
    .join(' · ');
};
---

<Base title={`${data.subject.standardsName} units`} subject={subject}>
  <h1>{data.subject.standardsName} units and topics</h1>
  <p class="muted prose">Units in Course at a Glance order, with exam weights. Each topic lists the lessons and questions tagged with it.</p>
  {progress.topics.size > 0 && (
    <p class="small legend">
      <span><ProgressMark status="done" /> {count(allIds, 'done')} this year</span>
      {count(allIds, 'review') > 0 && (
        <span>
          <ProgressMark status="review" /> {count(allIds, 'review')}
          {progress.lastYearCourse && <> in {progress.lastYearCourse}</>}
        </span>
      )}
      {count(allIds, 'partial') > 0 && (
        <span><ProgressMark status="partial" /> {count(allIds, 'partial')}</span>
      )}
      <span class="new">{count(allIds, null)} new</span>
    </p>
  )}
  {!data.ced.verified && (
    <p class="notice small">
      Topic list not yet verified against the current Course and Exam Description. Edit <code>src/data/{subject}/ced.json</code>
      and set <code>"verified": true</code> once checked.
    </p>
  )}
  {data.ced.units.map((unit) => {
    const ids = unit.topics.map((t) => t.id);
    const done = count(ids, 'done');
    const review = count(ids, 'review');
    return (
      <section class="unit" id={`unit-${unit.id}`}>
        <h2>
          Unit {unit.id}: {unit.title} {unit.examWeight && <span class="badge">{unit.examWeight} of exam</span>}
          {progress.topics.size > 0 && (
            <span class="unit-progress small muted">
              {done === ids.length ? '✓ all learned' : `${done}/${ids.length} learned`}
              {review > 0 && ` · ${review} seen last year`}
            </span>
          )}
        </h2>
        <ol class="plain-list topics">
          {unit.topics.map((t) => {
            const status = statusOf(t.id);
            const notes = progress.notes.get(t.id) ?? [];
            return (
              <li>
                <ProgressMark status={status} compact />
                <div class="info">
                  <span class="num">{t.id}</span>
                  <a href={url(`${subject}/ap/${t.id}/`)}>{t.title}</a>
                  {notes.map((note) => <div class="small muted">{note}</div>)}
                </div>
                <span class="small muted count">{counts(t.id)}</span>
              </li>
            );
          })}
        </ol>
      </section>
    );
  })}
</Base>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: center;
  }
  .legend > span {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }
  .unit h2 {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .unit-progress {
    font-weight: 400;
    margin-left: auto;
  }
  .topics li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.6rem;
    align-items: start;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--border);
  }
  .info {
    min-width: 0;
  }
  .count {
    white-space: nowrap;
    padding-top: 0.1rem;
  }
  .num {
    display: inline-block;
    min-width: 2.6rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
</style>
