---
import ProgressMark from '../../../components/ProgressMark.astro';
import Base from '../../../layouts/Base.astro';
import { hasTopics } from '../../../lib/features';
import { coverage, getLessons, kindCounts, getQuestions, getSubjectData, pastFrqLinks, subjectPathsWith, url } from '../../../lib/content';
import { matchFrqs } from '../../../lib/frqs';
import { plural } from '../../../lib/text';

export const getStaticPaths = subjectPathsWith(hasTopics);

const { subject } = Astro.params;
const data = getSubjectData(subject);
const cov = coverage(data, await getLessons(subject), await getQuestions(subject));
const { progress, textbookGaps } = data;
const statusOf = (id: string) => progress.topics.get(id) ?? null;
const count = (ids: string[], status: ReturnType<typeof statusOf>) => ids.filter((id) => statusOf(id) === status).length;
const allIds = [...data.topics.keys()];
const frqs = pastFrqLinks(data);
const frqCount = (id: string) => matchFrqs(frqs, new Set([id])).length;
/** "1 lesson · 2 questions · 3 past FRQs", leaving out zero counts. */
const counts = (id: string) => {
  const c = cov.get(id)!;
  return [
    kindCounts(c.lessons),
    c.questions && plural(c.questions, 'question'),
    frqCount(id) && plural(frqCount(id), 'past FRQ'),
  ]
    .filter(Boolean)
    .join(' · ');
};
const gapLabel = { missing: 'Not in textbook', thin: 'Thin in textbook' } as const;
---

<Base title="AP units and topics" subject={subject}>
  <h1>AP units and topics</h1>
  <p class="muted prose">
    Every topic on the AP exam, in the order of College Board's{' '}
    {data.subject.standardsUrl ? (
      <a href={data.subject.standardsUrl} target="_blank" rel="noopener">Course and Exam Description (PDF)</a>
    ) : (
      'Course and Exam Description'
    )}. Open a topic for its lessons, practice questions, and past FRQs.
  </p>

  <nav class="unit-nav jump-nav" aria-label="Units">
    <span class="jump-label" aria-hidden="true">Jump to</span>
    {data.ced.units.map((u) => (
      <a href={`#unit-${u.id}`} title={u.title}>Unit {u.id}</a>
    ))}
    {textbookGaps.topics.size > 0 && <a href="#textbook-gaps">Textbook gaps</a>}
  </nav>

  {progress.topics.size > 0 && (
    <p class="small legend">
      <span><ProgressMark status="done" compact /> {count(allIds, 'done')} covered in class</span>
      {count(allIds, 'partial') > 0 && (
        <span><ProgressMark status="partial" compact /> {count(allIds, 'partial')} partly covered</span>
      )}
      {count(allIds, 'review') > 0 && (
        <span>
          <ProgressMark status="review" compact /> {count(allIds, 'review')} seen
          {progress.lastYearCourse ? <> in {progress.lastYearCourse}</> : ' last year'}
        </span>
      )}
      {count(allIds, 'skipped') > 0 && (
        <span><ProgressMark status="skipped" compact /> {count(allIds, 'skipped')} skipped in class</span>
      )}
      <span><ProgressMark status={null} compact /> {count(allIds, null)} new</span>
      {textbookGaps.topics.size > 0 && <span><span class="badge gap">⚑</span> thin in textbook</span>}
    </p>
  )}
  {data.ced.units.map((unit) => {
    const ids = unit.topics.map((t) => t.id);
    const done = count(ids, 'done');
    const review = count(ids, 'review');
    return (
      <section class="unit" id={`unit-${unit.id}`} aria-labelledby={`unit-${unit.id}-h`}>
        <div class="unit-head">
          <h2 id={`unit-${unit.id}-h`}>Unit {unit.id}: {unit.title}</h2>
          {unit.examWeight && <span class="badge">{unit.examWeight} of exam</span>}
          {progress.topics.size > 0 && (
            <span class="unit-progress small muted">
              {done === ids.length ? '✓ all covered' : `${done}/${ids.length} covered`}
              {review > 0 && ` · ${review} seen last year`}
            </span>
          )}
        </div>
        <ol class="plain-list topics card">
          {unit.topics.map((t) => {
            const status = statusOf(t.id);
            const notes = progress.notes.get(t.id) ?? [];
            const gap = textbookGaps.topics.get(t.id);
            return (
              <li>
                <ProgressMark status={status} compact />
                <div class="info">
                  <span class="num">{t.id}</span>
                  <a href={url(`${subject}/ap/${t.id}/`)}>{t.title}</a>
                  {gap && <span class="badge gap">⚑ {gapLabel[gap.coverage]}</span>}
                  {notes.map((note) => <div class="small muted note">{note}</div>)}
                  {counts(t.id) && <div class="small muted count">{counts(t.id)}</div>}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    );
  })}

  {(textbookGaps.topics.size > 0 || textbookGaps.other.length > 0) && (
    <section id="textbook-gaps" aria-labelledby="gaps-h">
      <h2 id="gaps-h">What the textbook covers thinly</h2>
      <p class="prose">
        <em>{data.subject.textbook}</em> doesn't teach these well enough for the AP exam. Learn them from AP Classroom
        (the topic videos and practice), this site's lessons, or your teacher.
      </p>
      <div class="stack">
        {[...textbookGaps.topics].map(([id, gap]) => (
          <article class="card gap-card">
            <h3>
              <a href={url(`${subject}/ap/${id}/`)}>{id} {data.topics.get(id)!.title}</a>
              <span class="badge gap">{gapLabel[gap.coverage]}</span>
            </h3>
            <p><strong>In the book:</strong> {gap.book}</p>
            <p><strong>Learn elsewhere:</strong> {gap.learn}</p>
          </article>
        ))}
        {textbookGaps.other.map((gap) => (
          <article class="card gap-card">
            <h3>
              {gap.title}
              <span class="badge gap">{gapLabel[gap.coverage]}</span>
            </h3>
            <p><strong>In the book:</strong> {gap.book}</p>
            <p><strong>Learn elsewhere:</strong> {gap.learn}</p>
          </article>
        ))}
      </div>
    </section>
  )}
  {/* Until ced.json says "verified": true (see docs/data.md). At the bottom, so it doesn't push the topics down. */}
  {!data.ced.verified && (
    <p class="small muted unverified">This topic list hasn't been checked against the current Course and Exam Description yet.</p>
  )}
</Base>

<style>
  .unit-nav {
    margin: 1rem 0;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    align-items: center;
    color: var(--text-2);
  }
  .legend > span {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }
  .unit {
    scroll-margin-top: 1rem;
  }
  .unit-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    align-items: baseline;
    margin: 2rem 0 0.6rem;
  }
  .unit-head h2 {
    margin: 0;
  }
  .unit-progress {
    margin-left: auto;
  }
  .topics {
    padding: 0 1rem;
  }
  .topics li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
  }
  .topics li:last-child {
    border-bottom: 0;
  }
  .info a {
    font-weight: 600;
  }
  /* Wide enough for "7.10", with a gap before the title; notes line up under the title. */
  .num {
    display: inline-block;
    min-width: 2.7rem;
    margin-right: 0.45rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  .note,
  .count {
    padding-left: 3.15rem;
  }
  .badge.gap {
    background: var(--surface-2);
    color: var(--text-2);
    font-size: 0.72rem;
  }
  .info .badge.gap {
    margin-left: 0.4rem;
    vertical-align: 0.1em;
  }
  .unverified {
    margin-top: 2.5rem;
  }
  #textbook-gaps {
    scroll-margin-top: 1rem;
    margin-top: 2.5rem;
  }
  .gap-card h3 {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    font-size: 1.05rem;
  }
  .gap-card p {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
  }
  @media (max-width: 480px) {
    .note,
    .count {
      padding-left: 0;
    }
  }
</style>
