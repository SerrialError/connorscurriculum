---
import FrqCard from '../../../components/FrqCard.astro';
import LessonList from '../../../components/LessonList.astro';
import ProgressMark from '../../../components/ProgressMark.astro';
import Base from '../../../layouts/Base.astro';
import { formatDate, getLessons, getQuestions, getSubjectData, pastFrqLinks, practiceHref, practiceStart, subjectIds, url } from '../../../lib/content';
import { matchFrqs } from '../../../lib/frqs';

export function getStaticPaths() {
  return subjectIds().flatMap((subject) =>
    getSubjectData(subject).chapters.map((c) => ({ params: { subject, n: String(c.number) } })),
  );
}

const { subject, n } = Astro.params;
const data = getSubjectData(subject);
const chapter = data.chapterMap.get(Number(n))!;
const lessons = (await getLessons(subject)).filter((l) => l.data.chapter === chapter.number);
const questionCount = (await getQuestions(subject)).filter((q) => q.data.chapter === chapter.number).length;
const tests = data.tests.filter((t) => t.chapters.includes(chapter.number));
const prev = data.chapters[data.chapters.indexOf(chapter) - 1];
const next = data.chapters[data.chapters.indexOf(chapter) + 1];
const chapterLabel = `Chapter ${chapter.number}: ${chapter.title}`;
const finished = data.progress.chapters.has(chapter.number);
const current = data.progress.current.includes(chapter.number);

// CED topics this chapter teaches, in CED order, with where else they are taught.
const cedOrder = [...data.topics.keys()];
const topics = [...chapter.cedTopics]
  .sort((a, b) => cedOrder.indexOf(a) - cedOrder.indexOf(b))
  .map((id) => ({
    id,
    title: data.topics.get(id)!.title,
    status: data.progress.topics.get(id) ?? null,
    gap: data.textbookGaps.topics.get(id),
    alsoIn: (data.topicChapters.get(id) ?? []).filter((c) => c !== chapter.number),
  }));
const frqs = pastFrqLinks(data);
const frqCount = (id: string) => matchFrqs(frqs, new Set([id])).length;
const frqMatches = matchFrqs(frqs, new Set(chapter.cedTopics));
const frqParts = frqMatches.reduce((sum, m) => sum + m.parts.length, 0);
const plural = (k: number, word: string) => `${k} ${word}${k === 1 ? '' : 's'}`;
---

<Base title={chapterLabel} subject={subject} searchable searchMeta={{ chapter: chapterLabel }}>
  <nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore><a href={url(`${subject}/chapters/`)}>Chapters</a> /</nav>
  <h1>{chapterLabel}</h1>
  <div class="badges status" data-pagefind-ignore>
    {finished && <ProgressMark status="done" doneLabel="Finished in class" />}
    {current && <span class="badge now">● Now in class</span>}
    {chapter.apUnits.map((u) => (
      <a class="badge topic" href={url(`${subject}/ap/#unit-${u}`)}>
        AP Unit {u}: {data.ced.units.find((x) => x.id === u)?.title}
      </a>
    ))}
    {chapter.apUnits.length === 0 && <span class="badge not-ap">⊘ Not on the AP exam</span>}
  </div>

  <div class="actions" data-pagefind-ignore>
    {questionCount > 0 && (
      <>
        <a class="button" href={practiceStart(subject, { chapter: [chapter.number] }, questionCount).href}>
          {practiceStart(subject, { chapter: [chapter.number] }, questionCount).label}
        </a>
        <a class="button secondary" href={practiceHref(subject, { chapter: [chapter.number] })}>Choose filters ({questionCount} questions)</a>
      </>
    )}
    {tests.map((t) => (
      <a class="button secondary" href={url(`${subject}/tests/${t.id}/`)}>
        {t.title}{t.date && ` · ${formatDate(t.date)}`}
      </a>
    ))}
  </div>
  {questionCount === 0 && (
    <p class="small muted">
      No practice questions for this chapter yet.
      {frqMatches.length > 0 && <> Try the <a href="#frqs">past AP FRQs on its topics</a> below.</>}
    </p>
  )}

  <section id="lessons" aria-labelledby="lessons-h">
    <h2 id="lessons-h">Lessons and notes</h2>
    <LessonList
      lessons={lessons}
      grouped
      empty={current
        ? 'No lessons yet: the class is on this chapter now. Use the AP topics and past FRQs below, or write a lesson.'
        : 'No lessons yet.'}
    />
    {lessons.length === 0 && (
      <p class="small"><a href={url('admin/')}>Write a lesson for this chapter</a></p>
    )}
  </section>

  {topics.length > 0 && (
    <section aria-labelledby="topics-h">
      <h2 id="topics-h">AP topics in this chapter</h2>
      <ol class="plain-list topics">
        {topics.map((t) => (
          <li>
            <ProgressMark status={t.status} compact />
            <div class="info">
              <span class="num">{t.id}</span>
              <a href={url(`${subject}/ap/${t.id}/`)}>{t.title}</a>
              {t.gap && (
                <span class="badge gap" title="See the topic page for what to learn elsewhere">
                  ⚑ {t.gap.coverage === 'missing' ? 'Not in textbook' : 'Thin in textbook'}
                </span>
              )}
              {t.alsoIn.length > 0 && <div class="small muted">Also in Ch. {t.alsoIn.join(', ')}</div>}
            </div>
            {frqCount(t.id) > 0 && <span class="small muted count">{frqCount(t.id)} FRQ</span>}
          </li>
        ))}
      </ol>
    </section>
  )}

  {chapter.notOnAP.length > 0 && (
    <div class="notice small">
      <strong>In this chapter but not on the AP exam:</strong>
      <ul>
        {chapter.notOnAP.map((x) => <li>{x}</li>)}
      </ul>
    </div>
  )}

  {frqMatches.length > 0 && (
    <section id="frqs" data-pagefind-ignore="all" aria-labelledby="frqs-h">
      <h2 id="frqs-h">Past AP FRQs on these topics</h2>
      <details class="frqs">
        <summary>
          Show {plural(frqMatches.length, 'released question')} ({plural(frqParts, 'part')})
        </summary>
        <div class="stack">
          {frqMatches.map((m) => <FrqCard subject={subject} frq={m.frq} matched={m.parts} />)}
        </div>
      </details>
    </section>
  )}

  {chapter.sections.length > 0 && (
    <details class="sections">
      <summary>Textbook sections</summary>
      <ul>
        {chapter.sections.map((s) => <li>{s.id} {s.title}</li>)}
      </ul>
    </details>
  )}

  <nav class="pager" aria-label="Chapters">
    {prev ? (
      <a href={url(`${subject}/chapters/${prev.number}/`)}><span class="small muted">← Previous</span>Ch. {prev.number}: {prev.title}</a>
    ) : <span></span>}
    {next && (
      <a class="next" href={url(`${subject}/chapters/${next.number}/`)}><span class="small muted">Next →</span>Ch. {next.number}: {next.title}</a>
    )}
  </nav>
</Base>

<script>
  // Arriving via "#frqs" (e.g. from the subject page) should show the list, not a closed toggle.
  if (location.hash === '#frqs') document.querySelector<HTMLDetailsElement>('#frqs details')?.setAttribute('open', '');
</script>

<style>
  .status {
    margin-bottom: 0.25rem;
  }
  .badge.now {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: transparent;
  }
  .notice ul {
    margin: 0.3rem 0 0;
    padding-left: 1.2rem;
  }
  .topics li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.6rem;
    align-items: start;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .num {
    display: inline-block;
    min-width: 2.6rem;
    margin-right: 0.35rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .badge.gap {
    margin-left: 0.4rem;
    font-size: 0.72rem;
    vertical-align: 0.1em;
  }
  .count {
    white-space: nowrap;
    padding-top: 0.1rem;
  }
  .frqs summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--link);
    margin-bottom: 0.75rem;
  }
  .sections {
    margin-top: 1.5rem;
  }
  .sections summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--link);
  }
</style>
