---
import FrqCard from '../../../components/FrqCard.astro';
import LessonList from '../../../components/LessonList.astro';
import ProgressMark from '../../../components/ProgressMark.astro';
import Base from '../../../layouts/Base.astro';
import { formatDate, getLessons, getQuestions, getSubjectData, pastFrqLinks, practiceHref, subjectIds, url } from '../../../lib/content';
import { matchFrqs } from '../../../lib/frqs';

export function getStaticPaths() {
  return subjectIds().flatMap((subject) =>
    getSubjectData(subject).chapters.map((c) => ({ params: { subject, n: String(c.number) } })),
  );
}

const { subject, n } = Astro.params;
const data = getSubjectData(subject);
const chapter = data.chapterMap.get(Number(n))!;
const lessons = (await getLessons(subject)).filter((l) => l.data.chapter === chapter.number);
const questionCount = (await getQuestions(subject)).filter((q) => q.data.chapter === chapter.number).length;
const tests = data.tests.filter((t) => t.chapters.includes(chapter.number));
const prev = data.chapters[data.chapters.indexOf(chapter) - 1];
const next = data.chapters[data.chapters.indexOf(chapter) + 1];
const chapterLabel = `Chapter ${chapter.number}: ${chapter.title}`;

// CED topics this chapter teaches, in CED order, with where else they are taught.
const cedOrder = [...data.topics.keys()];
const topics = [...chapter.cedTopics]
  .sort((a, b) => cedOrder.indexOf(a) - cedOrder.indexOf(b))
  .map((id) => ({
    id,
    title: data.topics.get(id)!.title,
    status: data.progress.topics.get(id) ?? null,
    alsoIn: (data.topicChapters.get(id) ?? []).filter((c) => c !== chapter.number),
  }));
const frqs = pastFrqLinks(data);
const frqCount = (id: string) => matchFrqs(frqs, new Set([id])).length;
const frqMatches = matchFrqs(frqs, new Set(chapter.cedTopics));
const frqParts = frqMatches.reduce((sum, m) => sum + m.parts.length, 0);
---

<Base title={chapterLabel} subject={subject} searchable searchMeta={{ chapter: chapterLabel }}>
  <p class="breadcrumbs"><a href={url(`${subject}/chapters/`)}>Chapters</a> /</p>
  <h1>{chapterLabel}</h1>
  {data.progress.chapters.has(chapter.number) && (
    <p><ProgressMark status="done" doneLabel="Finished in class" /></p>
  )}
  <div class="badges">
    {chapter.apUnits.map((u) => (
      <a class="badge topic" href={url(`${subject}/ap/#unit-${u}`)}>
        AP Unit {u}: {data.ced.units.find((x) => x.id === u)?.title}
      </a>
    ))}
    {chapter.apUnits.length === 0 && <span class="badge not-ap">⊘ Not on the AP exam</span>}
  </div>
  {chapter.notOnAP.length > 0 && (
    <div class="notice small">
      <strong>Not on the AP exam:</strong>
      <ul>
        {chapter.notOnAP.map((x) => <li>{x}</li>)}
      </ul>
    </div>
  )}
  {chapter.sections.length > 0 && (
    <details>
      <summary>Sections</summary>
      <ul>
        {chapter.sections.map((s) => <li>{s.id} {s.title}</li>)}
      </ul>
    </details>
  )}

  <div class="actions">
    <a class="button" href={practiceHref(subject, { chapter: [chapter.number] })}>Practice this chapter ({questionCount})</a>
    {tests.map((t) => (
      <a class="button secondary" href={url(`${subject}/tests/${t.id}/`)}>
        {t.title}{t.date && ` · ${formatDate(t.date)}`}
      </a>
    ))}
  </div>

  {topics.length > 0 && (
    <>
      <h2>AP topics in this chapter</h2>
      <ol class="plain-list topics">
        {topics.map((t) => (
          <li>
            <ProgressMark status={t.status} compact />
            <div>
              <span class="num">{t.id}</span>
              <a href={url(`${subject}/ap/${t.id}/`)}>{t.title}</a>
              {t.alsoIn.length > 0 && (
                <div class="small muted">Also in Ch. {t.alsoIn.join(', ')}</div>
              )}
            </div>
            {frqCount(t.id) > 0 && <span class="small muted count">{frqCount(t.id)} FRQ</span>}
          </li>
        ))}
      </ol>
    </>
  )}

  <h2>Lessons</h2>
  <LessonList lessons={lessons} />

  {frqMatches.length > 0 && (
    <section id="frqs" data-pagefind-ignore="all">
      <h2>Past AP FRQs on these topics</h2>
      <details class="frqs">
        <summary>
          {frqMatches.length} released question{frqMatches.length === 1 ? '' : 's'}, {frqParts} part{frqParts === 1 ? '' : 's'}
        </summary>
        <div class="stack">
          {frqMatches.map((m) => <FrqCard subject={subject} frq={m.frq} matched={m.parts} />)}
        </div>
      </details>
    </section>
  )}

  <nav class="pager small" aria-label="Chapters">
    {prev ? <a href={url(`${subject}/chapters/${prev.number}/`)}>← Ch. {prev.number}: {prev.title}</a> : <span></span>}
    {next && <a href={url(`${subject}/chapters/${next.number}/`)}>Ch. {next.number}: {next.title} →</a>}
  </nav>
</Base>

<script>
  // Arriving via "#frqs" (e.g. from Up next) should show the list, not a closed toggle.
  if (location.hash === '#frqs') document.querySelector<HTMLDetailsElement>('#frqs details')?.setAttribute('open', '');
</script>

<style>
  .notice ul {
    margin: 0.3rem 0 0;
    padding-left: 1.2rem;
  }
  .topics li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.6rem;
    align-items: start;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--border);
  }
  .num {
    display: inline-block;
    min-width: 2.6rem;
    margin-right: 0.35rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .count {
    white-space: nowrap;
    padding-top: 0.1rem;
  }
  .frqs summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--link);
    margin-bottom: 0.75rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }
</style>
