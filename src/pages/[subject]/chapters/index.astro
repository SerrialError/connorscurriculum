---
import ProgressMark from '../../../components/ProgressMark.astro';
import Base from '../../../layouts/Base.astro';
import { getLessons, getQuestions, getSubjectData, nextChapter, subjectPaths, url } from '../../../lib/content';

export const getStaticPaths = subjectPaths;

const { subject } = Astro.params;
const data = getSubjectData(subject);
const lessons = await getLessons(subject);
const questions = await getQuestions(subject);
const { progress } = data;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;

const next = nextChapter(data);

/** "AP Units 3, 5 · 1 lesson · 6 questions", leaving out zero counts. */
const meta = (n: number, apUnits: string[]) => {
  const l = lessons.filter((x) => x.data.chapter === n).length;
  const q = questions.filter((x) => x.data.chapter === n).length;
  return [
    apUnits.length ? `AP Unit${apUnits.length > 1 ? 's' : ''} ${apUnits.join(', ')}` : 'Not on the AP exam',
    l && plural(l, 'lesson'),
    q && plural(q, 'question'),
  ]
    .filter(Boolean)
    .join(' · ');
};
---

<Base title="Chapters" subject={subject}>
  <h1>Chapters</h1>
  <p class="muted prose">Class order, following <em>{data.subject.textbook}</em>. Class tests follow these chapters.</p>
  {progress.chapters.size > 0 && (
    <p class="small">✓ The class has finished {progress.chapters.size} of {data.chapters.length} chapters.</p>
  )}
  <ol class="plain-list card chapters">
    {data.chapters.map((c) => {
      const done = progress.chapters.has(c.number);
      return (
        <li class:list={{ done, next: c === next }}>
          <ProgressMark status={done ? 'done' : null} compact doneLabel="Finished in class" />
          <div class="info">
            <span class="num">{c.number}.</span>
            <a href={url(`${subject}/chapters/${c.number}/`)}>{c.title}</a>
            {c === next && <span class="badge good">Up next</span>}
            {!done && <div class="small muted">{meta(c.number, c.apUnits)}</div>}
          </div>
        </li>
      );
    })}
  </ol>
</Base>

<style>
  .chapters {
    padding: 0.25rem 1rem;
  }
  .chapters li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
  }
  .chapters li:last-child {
    border-bottom: 0;
  }
  .info a {
    font-weight: 600;
  }
  .done .info a {
    color: var(--text-2);
    font-weight: 500;
  }
  .num {
    display: inline-block;
    min-width: 1.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .done .num {
    color: var(--text-2);
    font-weight: 500;
  }
  .info .small {
    margin-top: 0.1rem;
    padding-left: 1.8rem;
  }
  .badge {
    margin-left: 0.4rem;
  }
</style>
