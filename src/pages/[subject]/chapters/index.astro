---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProgressMark from '../../../components/ProgressMark.astro';
import Base from '../../../layouts/Base.astro';
import {
  formatDate,
  getLessons,
  getQuestions,
  getSubjectData,
  isClassContent,
  kindCounts,
  nextChapter,
  subjectPaths,
  testsByDate,
  url,
} from '../../../lib/content';
import { hasTopics } from '../../../lib/features';
import { plural } from '../../../lib/text';

export const getStaticPaths = subjectPaths;

const { subject } = Astro.params;
const data = getSubjectData(subject);
const lessons = await getLessons(subject);
const questions = await getQuestions(subject);
const { progress } = data;
const current = new Set(progress.current);
// Without "current" chapters, mark the next unfinished one instead.
const next = current.size ? undefined : nextChapter(data);
const tests = testsByDate(data);

/** "AP Units 3, 5 · 4 lessons · 3 notes pages · 6 questions", leaving out zero counts. Sample pages are counted as such. */
const meta = (n: number, apUnits: string[]) => {
  const ls = lessons.filter((x) => x.data.chapter === n);
  const qs = questions.filter((x) => x.data.chapter === n);
  const classLessons = ls.filter((x) => isClassContent(data, x));
  const q = qs.filter((x) => isClassContent(data, x)).length;
  return [
    hasTopics(data) && (apUnits.length ? `AP Unit${apUnits.length > 1 ? 's' : ''} ${apUnits.join(', ')}` : 'Not on the AP exam'),
    kindCounts(classLessons),
    q && plural(q, 'question'),
    ls.length - classLessons.length && plural(ls.length - classLessons.length, 'sample page'),
    qs.length - q && plural(qs.length - q, 'sample question'),
  ]
    .filter(Boolean)
    .join(' · ');
};
---

<Base title="Chapters" subject={subject}>
  <Breadcrumbs items={[{ href: url(`${subject}/lessons/`), label: 'Lessons' }]} />
  <h1>Chapters</h1>
  <p class="muted prose">
    Class order, following <em>{data.subject.textbook}</em>. Open a chapter for its lessons, classmates' notes, AP topics,
    and practice, or see <a href={url(`${subject}/lessons/`)}>every lesson</a> on one page.
  </p>

  {tests.length > 0 && (
    <section class="tests" aria-labelledby="tests-h">
      <h2 id="tests-h" class="visually-hidden">Class tests</h2>
      <p class="small">
        <strong>Class tests:</strong>{' '}
        {tests.map((t, i) => (
          <>
            {i > 0 && ' · '}
            <a href={url(`${subject}/tests/${t.id}/`)}>{t.title}</a>
            {t.date && <span class="muted"> ({formatDate(t.date)})</span>}
          </>
        ))}
      </p>
    </section>
  )}

  <p class="small legend">
    <span><ProgressMark status="done" compact doneLabel="Finished in class" /> Finished ({progress.chapters.size} of {data.chapters.length})</span>
    {current.size > 0 && <span><span class="badge now">Now</span> In class now</span>}
  </p>

  <ol class="plain-list card chapters">
    {data.chapters.map((c) => {
      const done = progress.chapters.has(c.number);
      const isNow = current.has(c.number) || c === next;
      // Only class material counts: sample pages for later chapters don't make a chapter stand out.
      const hasContent = [...lessons, ...questions].some((x) => x.data.chapter === c.number && isClassContent(data, x));
      return (
        <li class:list={{ done, now: isNow, empty: !hasContent }}>
          <ProgressMark status={done ? 'done' : null} compact doneLabel="Finished in class" />
          <span class="num">{c.number}</span>
          <div class="info">
            <a href={url(`${subject}/chapters/${c.number}/`)}>{c.title}</a>
            {isNow && <span class="badge now">{current.size ? 'Now' : 'Up next'}</span>}
            <div class="small muted">{meta(c.number, c.apUnits)}</div>
          </div>
        </li>
      );
    })}
  </ol>
</Base>

<style>
  .tests p {
    margin: 0 0 0.5rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    align-items: center;
    color: var(--text-2);
  }
  .legend > span {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }
  .chapters {
    padding: 0.25rem 1rem;
  }
  .chapters li {
    display: grid;
    grid-template-columns: auto 2rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: start;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }
  .chapters li:last-child {
    border-bottom: 0;
  }
  .chapters li.now .muted {
    color: var(--text-2);
  }
  .chapters li.now {
    margin: 0 -1rem;
    padding-inline: 1rem;
    background: var(--accent-soft);
  }
  /* Chapters with lessons or questions are bold; every chapter is a working link (AP topics, FRQs). */
  .info a {
    font-weight: 700;
  }
  .empty .info a {
    font-weight: 500;
  }
  .num {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: right;
    color: var(--text-2);
  }
  .info .small {
    margin-top: 0.1rem;
  }
  .info .badge {
    margin-left: 0.4rem;
  }
</style>
