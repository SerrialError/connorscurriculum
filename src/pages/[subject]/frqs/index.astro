---
import FrqCard from '../../../components/FrqCard.astro';
import Base from '../../../layouts/Base.astro';
import { hasPastFrqs } from '../../../lib/features';
import { getSubjectData, learnedTopic, pastFrqLinks, subjectPathsWith } from '../../../lib/content';
import { frqName, frqTotal, readyPoints } from '../../../lib/frqs';

export const getStaticPaths = subjectPathsWith(hasPastFrqs);

const { subject } = Astro.params;
const data = getSubjectData(subject);
const frqs = pastFrqLinks(data);
const learned = learnedTopic(data);
const ready = frqs.filter((f) => readyPoints(f, learned) === frqTotal(f));
const mostly = frqs.filter((f) => {
  const r = readyPoints(f, learned);
  return r < frqTotal(f) && r >= frqTotal(f) / 2;
});
const exams = data.pastFrqs;
---

<Base title="Past AP FRQs" subject={subject} searchable searchMeta={{ type: 'Past FRQs' }}>
  <h1>Past AP free-response questions</h1>
  <p class="muted prose">Released AP exam questions and their scoring guidelines, with how many points are on topics you've learned.</p>

  {frqs.length === 0 ? (
    <p class="muted">No past FRQs listed yet.</p>
  ) : (
    <>
      <section class="card summary" aria-labelledby="start-h">
        <h2 id="start-h">Where to start</h2>
        <p>
          <strong>Ready ({ready.length}):</strong>{' '}
          {ready.length ? ready.map((f, i) => <>{i > 0 && ', '}<a href={`#${f.year}-q${f.number}`}>{frqName(f)}</a></>) : 'none yet'}
        </p>
        {mostly.length > 0 && (
          <p>
            <strong>At least half ready ({mostly.length}):</strong>{' '}
            {mostly.map((f, i) => <>{i > 0 && ', '}<a href={`#${f.year}-q${f.number}`}>{frqName(f)}</a></>)}
          </p>
        )}
        <p>
          <span class="badge good">✓ Ready</span> means you have learned every topic in the question, this year or last year.
        </p>
      </section>

      <div class="toolbar">
        {exams.length > 1 && (
          <nav class="year-nav jump-nav" aria-label="Exam years">
            <span class="jump-label" aria-hidden="true">Jump to</span>
            {exams.map((e) => <a href={`#${e.year}`}>{e.year}</a>)}
          </nav>
        )}
        {ready.length > 0 && (
          <label class="ready-toggle small">
            <input type="checkbox" id="ready-only" />
            Only ready ({ready.length})
          </label>
        )}
      </div>

      {exams.map((exam) => (
        <section class="exam" data-exam>
          <h2 id={String(exam.year)}>{exam.year} exam</h2>
          <p class="small links">
            <a href={exam.questionsUrl} target="_blank" rel="noopener">All questions (PDF)</a>
            <a href={exam.scoringUrl} target="_blank" rel="noopener">All scoring guidelines (PDF)</a>
          </p>
          {exam.note && <p class="small muted">{exam.note}</p>}
          <div class="stack exam-cards">
            {frqs
              .filter((f) => f.year === exam.year)
              .map((f) => (
                <div id={`${f.year}-q${f.number}`} data-ready={readyPoints(f, learned) === frqTotal(f) ? '' : undefined}>
                  <FrqCard subject={subject} frq={f} />
                </div>
              ))}
          </div>
        </section>
      ))}

      <p class="small muted source">
        Questions © College Board, linked from AP Central. The topic tags are ours, so a few may be off.
      </p>
    </>
  )}
</Base>

<script>
  // "Only ready": hide questions you're not ready for, and exam years left empty. The choice is
  // kept in the address (?ready=1), so a reload or a shared link keeps it.
  const toggle = document.querySelector<HTMLInputElement>('#ready-only');
  const apply = () => {
    const only = !!toggle?.checked;
    for (const exam of document.querySelectorAll<HTMLElement>('[data-exam]')) {
      let shown = 0;
      for (const q of exam.querySelectorAll<HTMLElement>('.stack > [id]')) {
        q.hidden = only && !q.hasAttribute('data-ready');
        if (!q.hidden) shown++;
      }
      exam.hidden = shown === 0;
    }
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.year-nav a')) {
      const exam = document.getElementById(a.hash.slice(1))?.closest<HTMLElement>('[data-exam]');
      a.hidden = !!exam?.hidden;
    }
  };
  const save = () => {
    const u = new URL(location.href);
    if (toggle?.checked) u.searchParams.set('ready', '1');
    else u.searchParams.delete('ready');
    history.replaceState(history.state, '', u);
  };
  /** A link (or address) pointing at a question the filter hides turns the filter off first. */
  const reveal = (id: string) => {
    const target = id && document.getElementById(id);
    if (!toggle?.checked || !target || !target.closest('[hidden]')) return;
    toggle.checked = false;
    apply();
    save();
  };
  if (toggle) {
    toggle.checked = new URLSearchParams(location.search).get('ready') === '1';
    toggle.addEventListener('change', () => {
      apply();
      save();
    });
  }
  apply();
  reveal(decodeURIComponent(location.hash.slice(1)));
  if (location.hash) document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (a) reveal(decodeURIComponent(a.hash.slice(1)));
  });
</script>

<style>
  .summary h2 {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
  }
  .summary p {
    margin: 0.35rem 0;
  }
  /* Year links and the filter stay in reach on this long page. */
  .toolbar {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
    margin: 1rem -1rem 0;
    padding: 0.5rem 1rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .year-nav {
    flex-wrap: nowrap;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .year-nav a {
    flex: none;
  }
  .ready-toggle {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    font-weight: 600;
    cursor: pointer;
  }
  .ready-toggle input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent);
  }
  /* Two columns on wide screens: half as long to scroll. */
  .exam-cards {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    align-items: start;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }
  .source {
    margin-top: 2rem;
  }
  [id] {
    scroll-margin-top: 4.5rem;
  }
</style>
