---
import Search from '../../components/Search.astro';
import Base from '../../layouts/Base.astro';
import {
  chapterRange,
  currentChapters,
  formatDate,
  getLessons,
  getQuestions,
  getSubjectData,
  inTest,
  isClassContent,
  lessonHref,
  nextChapter,
  pastFrqLinks,
  practiceHref,
  practiceStart,
  subjectPaths,
  testsByDate,
  url,
} from '../../lib/content';
import { frqCountLabel, matchFrqs } from '../../lib/frqs';

export const getStaticPaths = subjectPaths;

const { subject } = Astro.params;
const data = getSubjectData(subject);
const { progress } = data;
// Class material only: sample pages for chapters the class hasn't reached stay off the home page.
const lessons = (await getLessons(subject)).filter((l) => isClassContent(data, l));
const questions = (await getQuestions(subject)).filter((q) => isClassContent(data, q));
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const cedOrder = [...data.topics.keys()];
const inCedOrder = (ids: string[]) => [...ids].sort((a, b) => cedOrder.indexOf(a) - cedOrder.indexOf(b));
const frqs = pastFrqLinks(data);

const topicCounts = { done: 0, review: 0, partial: 0, skipped: 0 };
for (const s of progress.topics.values()) topicCounts[s] += 1;
const newCount = data.topics.size - topicCounts.done - topicCounts.review - topicCounts.partial - topicCounts.skipped;

// "Now in class": the current chapters, or the next unfinished chapter when none are listed.
const now = currentChapters(data);
const nowChapters = now.length ? now : [nextChapter(data)].filter((c) => c !== undefined);
const chapterInfo = (n: number) => {
  const c = data.chapterMap.get(n)!;
  const frqMatches = matchFrqs(frqs, new Set(c.cedTopics));
  const own = lessons.filter((l) => l.data.chapter === n);
  return {
    chapter: c,
    topics: inCedOrder(c.cedTopics),
    lessons: own.length,
    teaching: own.filter((l) => l.data.kind === 'lesson'),
    notes: own.filter((l) => l.data.kind === 'notes'),
    questions: questions.filter((q) => q.data.chapter === n).length,
    frqs: frqMatches.length ? frqCountLabel(frqMatches) : '',
  };
};
const nowInfo = nowChapters.map((c) => chapterInfo(c.number));

// Latest class test, with its review sheets.
const test = testsByDate(data)[0];
const testReview = test ? lessons.filter((l) => l.data.kind === 'review' && inTest(test, l)) : [];
const testQuestions = test ? questions.filter((q) => inTest(test, q)).length : 0;
// Has the test happened? Decided again in the browser (script below), since the site is built
// once and read for weeks. The day of the test still counts as upcoming.
const today = new Date().toISOString().slice(0, 10);
const testPast = !!test?.date && test.date < today;

// Lessons for the latest finished chapters with any, most recent first.
const recent = [...progress.chapters]
  .sort((a, b) => b - a)
  .map(chapterInfo)
  .filter((c) => c.lessons > 0)
  .slice(0, 3);

const gapCount = data.textbookGaps.topics.size;
const skippedIds = inCedOrder([...progress.topics].filter(([, s]) => s === 'skipped').map(([id]) => id));
---

<Base title={data.subject.name} subject={subject}>
  <h1>{data.subject.name}</h1>
  <p class="muted lede">Textbook: <em>{data.subject.textbook}</em></p>
  <Search placeholder="Search lessons, notes, topics…" />

  <div class="dash">
    {nowInfo.length > 0 && (
      <section class="card now" aria-labelledby="now-h">
        <p class="eyebrow">{now.length ? 'Now in class' : 'Up next'}</p>
        <h2 id="now-h">{chapterRange(nowInfo.map((c) => c.chapter.number))}</h2>
        {/* Compact: one line per chapter. The topic list lives on the chapter page. */}
        {nowInfo.map((c) => (
          <div class="now-chapter">
            <h3>
              <a href={url(`${subject}/chapters/${c.chapter.number}/`)}>
                Chapter {c.chapter.number}: {c.chapter.title}
              </a>
            </h3>
            <p class="small links">
              {c.topics.length > 0 && (
                <a href={url(`${subject}/chapters/${c.chapter.number}/#topics`)}>{plural(c.topics.length, 'AP topic')}</a>
              )}
              {c.lessons + c.questions > 0 && (
                <>
                  <span class="muted">{[c.lessons && plural(c.lessons, 'lesson'), c.questions && plural(c.questions, 'question')].filter(Boolean).join(' · ')}</span>
                  {c.questions > 0 && <a href={practiceStart(subject, { chapter: [c.chapter.number] }, c.questions).href}>{practiceStart(subject, { chapter: [c.chapter.number] }, c.questions).label}</a>}
                </>
              )}
              {c.frqs && <a href={url(`${subject}/chapters/${c.chapter.number}/#frqs`)}>{c.frqs}</a>}
            </p>
          </div>
        ))}
        {nowInfo.every((c) => c.lessons + c.questions === 0) && (
          <p class="small muted empty-note">
            No lessons or practice questions yet. Use the AP topics and past FRQs above.
          </p>
        )}
      </section>
    )}

    {test && (
      <section class="card test" aria-labelledby="test-h" data-test-date={test.date} data-past={testPast ? '' : undefined}>
        {/* Before the test: what to study, with a big Start button. After it: quieter, for review. */}
        <p class="eyebrow"><span class="if-upcoming">Next class test</span><span class="if-past">Latest class test</span></p>
        <h2 id="test-h"><a href={url(`${subject}/tests/${test.id}/`)}>{test.title}</a></h2>
        <p class="small muted">
          {test.date ? formatDate(test.date) : 'Date TBA'} · {chapterRange(test.chapters)}<span class="if-past"> · done</span>
        </p>
        {testReview.length > 0 && (
          <ul class="plain-list review-links">
            {testReview.map((l) => (
              <li>
                <a href={lessonHref(l)}>{l.data.title}</a>
              </li>
            ))}
          </ul>
        )}
        {testQuestions > 0 && (
          <>
            <div class="actions if-upcoming">
              <a class="button" href={practiceHref(subject, { test: test.id, start: '1' })}>Start all {testQuestions} test questions</a>
            </div>
            <p class="small if-past review-practice">
              <a href={practiceHref(subject, { test: test.id, start: '1' })}>Practice all {testQuestions} test questions</a>
              <span class="muted"> · good review for later tests and the AP exam</span>
            </p>
          </>
        )}
        <p class="small"><a href={url(`${subject}/tests/`)}>All class tests</a></p>
      </section>
    )}
  </div>

  {recent.length > 0 && (
    <section aria-labelledby="lessons-h">
      <div class="section-head">
        <h2 id="lessons-h">Lessons</h2>
        <a href={url(`${subject}/lessons/`)}>All lessons and notes →</a>
      </div>
      <div class="grid lesson-cards">
        {recent.map((c) => (
          <div class="card chapter-card">
            <h3>
              <a href={url(`${subject}/chapters/${c.chapter.number}/`)}>
                <span class="muted">Ch. {c.chapter.number}</span> {c.chapter.title}
              </a>
            </h3>
            {c.teaching.length > 0 && (
              <ul class="plain-list lesson-links">
                {c.teaching.map((l) => (
                  <li><a href={lessonHref(l)}>{l.data.title}</a></li>
                ))}
              </ul>
            )}
            {c.notes.length > 0 && (
              <p class="small notes-line">
                <span class="muted">Classmates' notes:</span>{' '}
                {c.notes.map((l, i) => (
                  <>
                    {i > 0 && <span class="muted"> · </span>}
                    <a href={lessonHref(l)}>{l.data.authors.join(', ')}</a>
                  </>
                ))}
              </p>
            )}
            {c.questions > 0 && (
              <p class="small practice-line">
                <a href={practiceStart(subject, { chapter: [c.chapter.number] }, c.questions).href}>
                  {practiceStart(subject, { chapter: [c.chapter.number] }, c.questions).label}
                </a>
                <span class="muted"> · {c.questions} in this chapter</span>
              </p>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  <section aria-labelledby="progress-h">
    <h2 id="progress-h">Class progress</h2>
    <div class="card progress">
      <div class="stats">
        <a class="stat" href={url(`${subject}/chapters/`)}>
          <span class="big">{progress.chapters.size}<span class="of">/{data.chapters.length}</span></span>
          <span class="small">chapters finished</span>
        </a>
        <a class="stat" href={url(`${subject}/ap/`)}>
          <span class="big">{topicCounts.done}<span class="of">/{data.topics.size}</span></span>
          <span class="small">{data.subject.standardsName} topics covered</span>
        </a>
      </div>
      <ul class="plain-list small breakdown">
        {topicCounts.partial > 0 && <li><span class="mk partial" aria-hidden="true">◐</span><span>{topicCounts.partial} partly covered</span></li>}
        {topicCounts.review > 0 && <li><span class="mk review" aria-hidden="true">↺</span><span>{topicCounts.review} seen in {progress.lastYearCourse}</span></li>}
        {topicCounts.skipped > 0 && (
          <li>
            <span class="mk skipped" aria-hidden="true">!</span>
            <span>{topicCounts.skipped} skipped in class:{' '}
            {skippedIds.map((id, i) => (
              <>
                {i > 0 && ', '}
                <a href={url(`${subject}/ap/${id}/`)}>{id} {data.topics.get(id)!.title}</a>
              </>
            ))}</span>
          </li>
        )}
        <li><span class="mk" aria-hidden="true"></span><span>{newCount} completely new</span></li>
        {gapCount > 0 && (
          <li>
            <span class="mk gap" aria-hidden="true">⚑</span>
            <a href={url(`${subject}/ap/#textbook-gaps`)}>{gapCount} topics the textbook covers thinly</a>
          </li>
        )}
      </ul>
    </div>
  </section>

</Base>

<script is:inline>
  // Past or upcoming, by the reader's date (the build date can be weeks old).
  (() => {
    const d = new Date();
    const today = [d.getFullYear(), String(d.getMonth() + 1).padStart(2, '0'), String(d.getDate()).padStart(2, '0')].join('-');
    for (const el of document.querySelectorAll('[data-test-date]')) el.toggleAttribute('data-past', el.dataset.testDate < today);
  })();
</script>

<style>
  .lede {
    margin-top: -0.25rem;
  }
  .dash {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: start;
  }
  .eyebrow {
    margin: 0 !important;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .dash h2 {
    margin: 0.1rem 0 0.4rem;
    font-size: 1.3rem;
  }
  .now {
    border-top: 4px solid var(--accent);
  }
  .test {
    border-top: 4px solid var(--tip);
  }
  .test .eyebrow {
    color: var(--tip);
  }
  .test:not([data-past]) .if-past,
  .test[data-past] .if-upcoming {
    display: none;
  }
  /* A test that's over is review material: no coloured stripe, no big button. */
  .test[data-past] {
    border-top-color: var(--border);
  }
  .test[data-past] .eyebrow {
    color: var(--muted);
  }
  .review-practice {
    margin: 0.5rem 0 0 !important;
  }
  .now-chapter {
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
  }
  .now-chapter:first-of-type {
    border-top: 0;
    padding-top: 0.2rem;
  }
  .now-chapter h3 {
    margin: 0 0 0.15rem;
    font-size: 1.05rem;
  }
  .empty-note {
    margin: 0.6rem 0 0 !important;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin: 0 !important;
  }
  .review-links {
    margin: 0.5rem 0 0;
  }
  .review-links a {
    font-weight: 600;
  }
  .review-links a::before {
    content: '★ ';
    color: var(--tip);
  }
  .test .actions {
    margin-bottom: 0.25rem;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .section-head a {
    font-weight: 600;
  }
  .chapter-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  /* Two wide cards rather than three narrow ones, matching the cards above. */
  .lesson-cards {
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .notes-line a {
    white-space: nowrap;
  }
  .lesson-links li {
    padding: 0.15rem 0;
  }
  .lesson-links a {
    font-weight: 600;
  }
  .notes-line,
  .practice-line {
    margin-top: 0.5rem !important;
  }
  .chapter-card h3 a {
    text-decoration: none;
  }
  .chapter-card h3 a:hover {
    text-decoration: underline;
  }
  .progress {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    align-items: center;
  }
  .stats {
    display: flex;
    gap: 2rem;
  }
  .stat {
    display: grid;
    color: inherit;
    text-decoration: none;
  }
  .stat:hover .small {
    text-decoration: underline;
  }
  .big {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .of {
    font-size: 1.1rem;
    color: var(--muted);
    font-weight: 600;
  }
  .breakdown {
    display: grid;
    gap: 0.2rem;
  }
  .breakdown li {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .mk {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
    border: 1.5px dashed var(--border);
  }
  .mk.partial,
  .mk.review,
  .mk.skipped,
  .mk.gap {
    border: 0;
  }
  .mk.partial {
    background: var(--warn-soft);
    color: var(--warn);
  }
  .mk.review {
    background: var(--tip-soft);
    color: var(--tip);
  }
  .mk.skipped {
    background: var(--bad-soft);
    color: var(--bad);
  }
  .mk.gap {
    background: var(--surface-2);
    color: var(--text-2);
  }
</style>
