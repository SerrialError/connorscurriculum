---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Search from '../../components/Search.astro';
import TestWhen from '../../components/TestWhen.astro';
import Base from '../../layouts/Base.astro';
import { classHome } from '../../lib/class-home';
import { getClassSummary, getSubjectData, isPastTest, lessonHref, pastFrqLinks, practiceUrl, subjectPaths, url } from '../../lib/content';
import { searchPlaceholder } from '../../lib/features';
import { chapterName, chapterRange, plural } from '../../lib/text';

export const getStaticPaths = subjectPaths;

const { subject } = Astro.params;
const data = getSubjectData(subject);
// Class material only (no samples, nothing from chapters not reached), as on the dashboard card.
const { now, test, recent, topics } = classHome(data, await getClassSummary(data), pastFrqLinks(data));
const chapterHref = (n: number, hash = '') => url(`${subject}/chapters/${n}/${hash}`);
---

<Base title={data.subject.name} subject={subject}>
  <Breadcrumbs items={[{ href: url(), label: 'All classes' }]} />
  <h1>{data.subject.name}</h1>
  <Search subject={subject} placeholder={searchPlaceholder(data)} />

  <div class="dash">
    {now.chapters.length > 0 && (
      <section class="card now" aria-labelledby="now-h">
        <h2 id="now-h" class="eyebrow">{now.label}</h2>
        {/* Compact: one line per chapter. The topic list lives on the chapter page. */}
        {now.chapters.map((c) => (
          <div class="now-chapter">
            <h3>
              <a href={chapterHref(c.chapter.number)}>{chapterName(c.chapter)}</a>
            </h3>
            <p class="small links">
              {c.topics.length > 0 && <a href={chapterHref(c.chapter.number, '#topics')}>{plural(c.topics.length, 'AP topic')}</a>}
              {(c.pages || c.questions > 0) && (
                <span class="muted">{[c.pages, c.questions && plural(c.questions, 'question')].filter(Boolean).join(' · ')}</span>
              )}
              {c.practice && <a href={practiceUrl(subject, c.practice.query)}>{c.practice.label}</a>}
              {c.frqs && <a href={chapterHref(c.chapter.number, '#frqs')}>{c.frqs}</a>}
            </p>
          </div>
        ))}
        {now.chapters.every((c) => !c.pages && c.questions === 0) && (
          <p class="small muted empty-note">
            No lessons or practice questions yet.
            {topics && ` Study from the ${now.chapters.some((c) => c.frqs) ? 'AP topics and past FRQs' : 'AP topics'} above.`}
          </p>
        )}
      </section>
    )}

    {test && (
      <section class="card test" aria-labelledby="test-h" data-test-date={test.test.date} data-past={isPastTest(test.test) ? '' : undefined}>
        {/* Before the test: what to study, with a big Start button. After it: quieter, for review. */}
        <p class="eyebrow"><span class="if-upcoming">Next class test</span><span class="if-past">Latest class test</span></p>
        <h2 id="test-h"><a href={url(`${subject}/tests/${test.test.id}/`)}>{test.test.title}</a></h2>
        <p class="small muted">
          <TestWhen test={test.test} /> · {chapterRange(test.test.chapters)}
        </p>
        {test.review.length > 0 && (
          <ul class="plain-list review-links">
            {test.review.map((l) => (
              <li>
                <a href={lessonHref(l)}>{l.data.title}</a>
              </li>
            ))}
          </ul>
        )}
        {test.practice && (
          <>
            <div class="actions if-upcoming">
              <a class="button" href={practiceUrl(subject, test.practice.start.query)}>{test.practice.start.label}</a>
              {test.practice.all && <a class="button secondary" href={practiceUrl(subject, test.practice.all.query)}>{test.practice.all.label}</a>}
              {test.exam && <a class="button secondary" href={practiceUrl(subject, test.exam.query)}>{test.exam.label}</a>}
            </div>
            {/* After the test: review practice, as quiet links. */}
            <p class="small if-past review-practice">
              <span class="muted">Practice:</span> <a href={practiceUrl(subject, test.practice.start.query)}>{test.practice.start.short}</a>
              {test.practice.all && <><span class="muted"> · </span><a href={practiceUrl(subject, test.practice.all.query)}>{test.practice.all.short}</a></>}
              {test.exam && <><span class="muted"> · </span><a href={practiceUrl(subject, test.exam.query)}>practice exam</a></>}
            </p>
          </>
        )}
        <p class="small"><a href={url(`${subject}/tests/`)}>All class tests</a></p>
      </section>
    )}
  </div>

  {recent.length > 0 && (
    <section aria-labelledby="lessons-h">
      <div class="section-head">
        <h2 id="lessons-h">Lessons</h2>
        <a href={url(`${subject}/lessons/`)}>All lessons and notes →</a>
      </div>
      <div class="grid lesson-cards">
        {recent.map((c) => (
          <div class="card chapter-card">
            <h3>
              <a href={chapterHref(c.chapter.number)}>
                <span class="muted">Chapter {c.chapter.number}:</span> {c.chapter.title}
              </a>
            </h3>
            {c.lessons.length > 0 && (
              <ul class="plain-list lesson-links">
                {c.lessons.map((l) => (
                  <li><a href={lessonHref(l)}>{l.data.title}</a></li>
                ))}
              </ul>
            )}
            {c.notes.length > 0 && (
              <p class="small notes-line">
                <span class="muted">Classmates' notes:</span>{' '}
                {c.notes.map((l, i) => (
                  <>
                    {i > 0 && <span class="muted"> · </span>}
                    <a href={lessonHref(l)}>{l.data.authors.join(', ')}</a>
                  </>
                ))}
              </p>
            )}
            {c.practice && (
              <p class="small practice-line">
                <a href={practiceUrl(subject, c.practice.query)}>{c.practice.label}</a>
                <span class="muted"> · {c.questions} in this chapter</span>
              </p>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  <section aria-labelledby="progress-h">
    <h2 id="progress-h">Class progress</h2>
    <div class="card progress">
      <div class="stats">
        <a class="stat" href={url(`${subject}/chapters/`)}>
          <span class="big">{data.progress.chapters.size}<span class="of">/{data.chapters.length}</span></span>
          <span class="small">chapters finished</span>
        </a>
        {topics && (
          <a class="stat" href={url(`${subject}/ap/`)}>
            <span class="big">{topics.done}<span class="of">/{topics.total}</span></span>
            <span class="small">AP topics covered</span>
          </a>
        )}
      </div>
      {topics && (
        <ul class="plain-list small breakdown">
          {topics.partial > 0 && <li><span class="mk partial" aria-hidden="true">◐</span><span>{topics.partial} partly covered</span></li>}
          {topics.review > 0 && <li><span class="mk review" aria-hidden="true">↺</span><span>{topics.review} seen in {data.progress.lastYearCourse}</span></li>}
          {topics.skipped.length > 0 && (
            <li>
              <span class="mk skipped" aria-hidden="true">!</span>
              <span>{topics.skipped.length} skipped in class:{' '}
              {topics.skipped.map((t, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={url(`${subject}/ap/${t.id}/`)}>{t.id} {t.title}</a>
                </>
              ))}</span>
            </li>
          )}
          <li><span class="mk" aria-hidden="true"></span><span>{topics.untouched} completely new</span></li>
          {topics.gaps > 0 && (
            <li>
              <span class="mk gap" aria-hidden="true">⚑</span>
              <a href={url(`${subject}/ap/#textbook-gaps`)}>{topics.gaps} topics the textbook covers thinly</a>
            </li>
          )}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  .dash {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: start;
  }
  .eyebrow {
    margin: 0;
    color: var(--accent);
  }
  .dash h2:not(.eyebrow) {
    margin: 0.1rem 0 0.4rem;
    font-size: 1.3rem;
  }
  .now {
    border-top: 4px solid var(--accent);
  }
  .test {
    border-top: 4px solid var(--tip);
  }
  .test .eyebrow {
    color: var(--tip);
  }
  /* A test that's over is review material: no coloured stripe, no big button. */
  .test[data-past] {
    border-top-color: var(--border);
  }
  .test[data-past] .eyebrow {
    color: var(--muted);
  }
  .review-practice {
    margin: 0.5rem 0 0;
  }
  .now-chapter {
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
  }
  .now-chapter:first-of-type {
    border-top: 0;
    padding-top: 0.2rem;
  }
  .now-chapter h3 {
    margin: 0 0 0.15rem;
    font-size: 1.05rem;
  }
  .empty-note {
    margin: 0.6rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin: 0;
  }
  .review-links {
    margin: 0.5rem 0 0;
  }
  .review-links a {
    font-weight: 600;
  }
  .test .actions {
    margin-bottom: 0.25rem;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .section-head a {
    font-weight: 600;
  }
  .chapter-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  /* Two wide cards rather than three narrow ones, matching the cards above. */
  .lesson-cards {
    gap: 1rem;
    align-items: start;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .notes-line a {
    white-space: nowrap;
  }
  .lesson-links li {
    padding: 0.15rem 0;
  }
  .lesson-links a {
    font-weight: 600;
  }
  .notes-line,
  .practice-line {
    margin-top: 0.5rem;
  }
  .chapter-card h3 a {
    text-decoration: none;
  }
  .chapter-card h3 a:hover {
    text-decoration: underline;
  }
  .progress {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    align-items: center;
  }
  .stats {
    display: flex;
    gap: 2rem;
  }
  .stat {
    display: grid;
    color: inherit;
    text-decoration: none;
  }
  .stat:hover .small {
    text-decoration: underline;
  }
  .big {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .of {
    font-size: 1.1rem;
    color: var(--muted);
    font-weight: 600;
  }
  .breakdown {
    display: grid;
    gap: 0.2rem;
  }
  .breakdown li {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .mk {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
    border: 1.5px dashed var(--border);
  }
  .mk.partial,
  .mk.review,
  .mk.skipped,
  .mk.gap {
    border: 0;
  }
  .mk.partial {
    background: var(--warn-soft);
    color: var(--warn);
  }
  .mk.review {
    background: var(--tip-soft);
    color: var(--tip);
  }
  .mk.skipped {
    background: var(--bad-soft);
    color: var(--bad);
  }
  .mk.gap {
    background: var(--surface-2);
    color: var(--text-2);
  }
</style>
