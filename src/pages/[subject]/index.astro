---
import Search from '../../components/Search.astro';
import TopicBadges from '../../components/TopicBadges.astro';
import Base from '../../layouts/Base.astro';
import { getSubjectData, nextChapter, pastFrqLinks, practiceHref, subjectPaths, url } from '../../lib/content';
import { matchFrqs } from '../../lib/frqs';

export const getStaticPaths = subjectPaths;

const { subject } = Astro.params;
const data = getSubjectData(subject);
const progress = data.progress;
const doneChapters = data.chapters.filter((c) => progress.chapters.has(c.number));
const topicCounts = { done: 0, review: 0, partial: 0 };
for (const s of progress.topics.values()) topicCounts[s] += 1;

const next = nextChapter(data);
const cedOrder = [...data.topics.keys()];
const nextTopics = next ? [...next.cedTopics].sort((a, b) => cedOrder.indexOf(a) - cedOrder.indexOf(b)) : [];
const nextFrqs = matchFrqs(pastFrqLinks(data), new Set(nextTopics));
const nextFrqParts = nextFrqs.reduce((sum, m) => sum + m.parts.length, 0);
---

<Base title={data.subject.name} subject={subject}>
  <h1>{data.subject.name}</h1>
  <p class="muted">Textbook: <em>{data.subject.textbook}</em></p>
  <Search placeholder={`Search ${data.subject.name}…`} />

  {(doneChapters.length > 0 || progress.topics.size > 0) && (
    <section class="card progress">
      <h2>Class progress</h2>
      <p>
        <a href={url(`${subject}/chapters/`)}>
          ✓ {doneChapters.length} of {data.chapters.length} chapters
        </a>
        {doneChapters.length > 0 && (
          <span class="muted"> (finished: {doneChapters.map((c) => c.number).join(', ')})</span>
        )}
      </p>
      <p>
        <a href={url(`${subject}/ap/`)}>
          ✓ {topicCounts.done} of {data.topics.size} {data.subject.standardsName} topics
        </a>
        {topicCounts.partial > 0 && <span class="muted"> · ◐ {topicCounts.partial} partly</span>}
      </p>
      {topicCounts.review > 0 && (
        <p>
          ↺ {topicCounts.review} more seen in {progress.lastYearCourse}
        </p>
      )}
      <p class="small muted">
        {data.topics.size - topicCounts.done - topicCounts.review - topicCounts.partial} topics are completely new.
      </p>
    </section>
  )}

  {next && (
    <section class="card up-next">
      <h2>Up next</h2>
      <p class="chapter">
        <a href={url(`${subject}/chapters/${next.number}/`)}>
          Chapter {next.number}: {next.title}
        </a>
      </p>
      <TopicBadges subject={subject} topics={nextTopics} />
      <p class="links small">
        {nextFrqParts > 0 && (
          <a href={url(`${subject}/chapters/${next.number}/#frqs`)}>
            {nextFrqParts} past AP FRQ part{nextFrqParts === 1 ? '' : 's'} on these topics
          </a>
        )}
        <a href={practiceHref(subject, { chapter: [next.number] })}>Practice this chapter</a>
      </p>
    </section>
  )}
</Base>

<style>
  .progress {
    margin-top: 1rem;
  }
  .progress h2 {
    margin: 0 0 0.3rem;
    font-size: 1.15rem;
  }
  .progress p {
    margin: 0.2rem 0;
  }
  .up-next {
    margin-top: 1rem;
  }
  .up-next h2 {
    margin: 0 0 0.3rem;
    font-size: 1.15rem;
  }
  .up-next .chapter {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .up-next .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0.75rem 0 0;
  }
</style>
