---
import { render } from 'astro:content';
import Callout from '../../../components/Callout.astro';
import Reveal from '../../../components/Reveal.astro';
import TopicBadges from '../../../components/TopicBadges.astro';
import YouTube from '../../../components/YouTube.astro';
import Base from '../../../layouts/Base.astro';
import {
  type Lesson,
  getLessons,
  getQuestions,
  getSubjectData,
  lessonSlug,
  practiceHref,
  subjectIds,
  topicIds,
  url,
} from '../../../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const subject of subjectIds()) {
    const lessons = await getLessons(subject);
    for (const lesson of lessons) {
      const siblings = lessons.filter((l) => l.data.chapter === lesson.data.chapter);
      const i = siblings.indexOf(lesson);
      paths.push({
        params: { subject, slug: lessonSlug(lesson) },
        props: { lesson, prev: siblings[i - 1], next: siblings[i + 1] },
      });
    }
  }
  return paths;
}

interface Props {
  lesson: Lesson;
  prev?: Lesson;
  next?: Lesson;
}

const { subject } = Astro.params;
const { lesson, prev, next } = Astro.props;
const { Content } = await render(lesson);
const data = getSubjectData(subject);
const chapter = data.chapterMap.get(lesson.data.chapter)!;
const topics = topicIds(lesson);
const chapterLabel = `Chapter ${chapter.number}: ${chapter.title}`;
// Practice the lesson's topics; fall back to its chapter when no question has those topics.
const questions = await getQuestions(subject);
const topicQuestions = questions.filter((q) => topicIds(q).some((t) => topics.includes(t))).length;
const chapterQuestions = questions.filter((q) => q.data.chapter === chapter.number).length;
const practice = topicQuestions
  ? { href: practiceHref(subject, { topic: topics }), label: `Practice these topics (${topicQuestions})` }
  : chapterQuestions
    ? { href: practiceHref(subject, { chapter: [chapter.number] }), label: `Practice Chapter ${chapter.number} (${chapterQuestions})` }
    : null;
const lessonHref = (l: Lesson) => url(`${subject}/lessons/${lessonSlug(l)}/`);
---

<Base
  title={lesson.data.title}
  description={lesson.data.summary}
  subject={subject}
  searchable={!lesson.data.draft}
  searchMeta={{ chapter: chapterLabel }}
>
  <article class="prose">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={url(`${subject}/chapters/`)}>Chapters</a> / <a href={url(`${subject}/chapters/${chapter.number}/`)}>{chapterLabel}</a>
      {lesson.data.sections.length > 0 && <> · §{lesson.data.sections.join(', ')}</>}
    </nav>
    <h1>
      {lesson.data.title}
      {lesson.data.draft && <span class="badge">Draft</span>}
    </h1>
    <TopicBadges subject={subject} topics={topics} />
    <p class="small muted">By {lesson.data.authors.join(', ')}</p>

    <Content components={{ YouTube, Callout, Reveal }} />

    <footer class="lesson-footer">
      <div class="actions">
        {practice && <a class="button" href={practice.href}>{practice.label}</a>}
        <a class="button secondary" href={url(`${subject}/chapters/${chapter.number}/#lessons`)}>All Chapter {chapter.number} lessons</a>
      </div>
      <nav class="pager" aria-label="Lessons in this chapter">
        {prev ? <a href={lessonHref(prev)}><span class="small muted">← Previous</span>{prev.data.title}</a> : <span></span>}
        {next && <a class="next" href={lessonHref(next)}><span class="small muted">Next →</span>{next.data.title}</a>}
      </nav>
    </footer>
  </article>
</Base>

<style>
  article :global(img) {
    border-radius: var(--radius);
    background: #fff;
  }
  .lesson-footer {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
</style>
