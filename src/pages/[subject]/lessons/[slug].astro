---
import { render } from 'astro:content';
import Callout from '../../../components/Callout.astro';
import Reveal from '../../../components/Reveal.astro';
import TopicBadges from '../../../components/TopicBadges.astro';
import TopicLegend from '../../../components/TopicLegend.astro';
import YouTube from '../../../components/YouTube.astro';
import Base from '../../../layouts/Base.astro';
import {
  type Lesson,
  getLessons,
  getQuestions,
  getSubjectData,
  inTest,
  lessonSlug,
  practiceHref,
  practiceStart,
  subjectIds,
  topicIds,
  url,
} from '../../../lib/content';

export async function getStaticPaths() {
  const paths = [];
  for (const subject of subjectIds()) {
    const lessons = await getLessons(subject);
    for (const lesson of lessons) {
      const siblings = lessons.filter((l) => l.data.chapter === lesson.data.chapter);
      const i = siblings.indexOf(lesson);
      paths.push({
        params: { subject, slug: lessonSlug(lesson) },
        props: { lesson, prev: siblings[i - 1], next: siblings[i + 1] },
      });
    }
  }
  return paths;
}

interface Props {
  lesson: Lesson;
  prev?: Lesson;
  next?: Lesson;
}

const { subject } = Astro.params;
const { lesson, prev, next } = Astro.props;
const { Content } = await render(lesson);
const data = getSubjectData(subject);
const chapter = data.chapterMap.get(lesson.data.chapter)!;
const topics = topicIds(lesson);
const chapterLabel = `Chapter ${chapter.number}: ${chapter.title}`;
// Practice the lesson's topics; fall back to its chapter when no question has those topics.
const questions = await getQuestions(subject);
const topicQuestions = questions.filter((q) => topicIds(q).some((t) => topics.includes(t))).length;
const chapterQuestions = questions.filter((q) => q.data.chapter === chapter.number).length;
const practiceQuery: { topic?: string[]; chapter?: number[] } = topicQuestions ? { topic: topics } : { chapter: [chapter.number] };
const practiceCount = topicQuestions || chapterQuestions;
const practice = practiceCount
  ? {
      start: practiceStart(
        subject,
        practiceQuery,
        practiceCount,
        topicQuestions ? (topics.length === 1 ? 'on this topic' : 'on these topics') : `from Chapter ${chapter.number}`,
      ),
      setup: practiceHref(subject, practiceQuery),
    }
  : null;
const lessonHref = (l: Lesson) => url(`${subject}/lessons/${lessonSlug(l)}/`);
// A test review sheet belongs to its test: link to the test and practice the whole test, not
// just the sheet's topics, and leave out the chapter's previous/next lessons.
const test = lesson.data.kind === 'review' ? data.tests.find((t) => inTest(t, lesson)) : undefined;
const testHref = test && url(`${subject}/tests/${test.id}/`);
const testQuestions = test ? questions.filter((q) => inTest(test, q)).length : 0;
const testPractice =
  test && testQuestions
    ? { href: practiceHref(subject, { test: test.id, start: '1' }), label: `Start all ${testQuestions} test questions` }
    : null;
---

<Base
  title={lesson.data.title}
  description={lesson.data.summary}
  subject={subject}
  searchable={!lesson.data.draft}
  searchMeta={{ chapter: chapterLabel }}
  section={test ? 'Tests' : undefined}
>
  <article class="prose">
    <nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
      {test ? (
        <>
          <a href={url(`${subject}/tests/`)}>Class tests</a> / <a href={testHref}>{test.title}</a> /
        </>
      ) : (
        <>
          <a href={url(`${subject}/chapters/`)}>Chapters</a> / <a href={url(`${subject}/chapters/${chapter.number}/`)}>{chapterLabel}</a>
          {lesson.data.sections.length > 0 && <> · §{lesson.data.sections.join(', ')}</>}
        </>
      )}
    </nav>
    <h1>
      {lesson.data.title}
      {lesson.data.draft && <span class="badge">Draft</span>}
    </h1>
    <TopicBadges subject={subject} topics={topics} />
    <TopicLegend subject={subject} topics={topics} />
    <p class="small muted" data-pagefind-ignore>By {lesson.data.authors.join(', ')}</p>
    {test && (
      <p class="test-note">
        Review sheet for the <a href={testHref}>{test.title}</a>.
        {testPractice && <> When you're done, <a href={testPractice.href}>start the test's {testQuestions} practice questions</a>.</>}
      </p>
    )}

    <Content components={{ YouTube, Callout, Reveal }} />

    <footer class="lesson-footer" data-pagefind-ignore>
      {test ? (
        <div class="actions">
          {testPractice && <a class="button" href={testPractice.href}>{testPractice.label}</a>}
          <a class="button secondary" href={testHref}>Back to the {test.title}</a>
        </div>
      ) : (
        <>
          <div class="actions">
            {practice && (
              <>
                <a class="button" href={practice.start.href}>{practice.start.label}</a>
                <a class="button secondary" href={practice.setup}>Choose filters</a>
              </>
            )}
            <a class="button secondary" href={url(`${subject}/chapters/${chapter.number}/#lessons`)}>All Chapter {chapter.number} lessons</a>
          </div>
          <nav class="pager" aria-label="Lessons in this chapter">
            {prev ? <a href={lessonHref(prev)}><span class="small muted">← Previous</span>{prev.data.title}</a> : <span></span>}
            {next && <a class="next" href={lessonHref(next)}><span class="small muted">Next →</span>{next.data.title}</a>}
          </nav>
        </>
      )}
    </footer>
  </article>
</Base>

<style>
  article :global(img) {
    border-radius: var(--radius);
    background: #fff;
  }
  .test-note {
    padding: 0.6rem 0.9rem;
    border-left: 4px solid var(--tip);
    border-radius: 0 8px 8px 0;
    background: var(--tip-soft);
  }
  .lesson-footer {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
</style>
