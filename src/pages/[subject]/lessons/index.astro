---
// Every lesson, classmates' notes page, and review sheet, grouped by chapter with the chapters the
// class is on (or just finished) first. Sample pages for chapters the class hasn't reached sit in
// a closed section at the end. A small filter (kind + text) narrows the list in place.
import LessonList from '../../../components/LessonList.astro';
import TopicLegend from '../../../components/TopicLegend.astro';
import Base from '../../../layouts/Base.astro';
import {
  LESSON_KINDS,
  getLessons,
  getQuestions,
  getSubjectData,
  isClassContent,
  isTaught,
  practiceStart,
  subjectPaths,
  topicIds,
  url,
} from '../../../lib/content';
import { chapterRange, plural } from '../../../lib/text';

export const getStaticPaths = subjectPaths;

const { subject } = Astro.params;
const data = getSubjectData(subject);
const all = await getLessons(subject);
const questions = await getQuestions(subject);
const lessons = all.filter((l) => isClassContent(data, l));
const samples = all.filter((l) => !isClassContent(data, l));
const current = new Set(data.progress.current);

// Chapters in study order: the ones in class now, then finished chapters, latest first.
const taught = data.chapters
  .filter((c) => isTaught(data, c.number))
  .sort((a, b) => Number(current.has(b.number)) - Number(current.has(a.number)) || b.number - a.number);
const sections = taught
  .map((c) => ({
    chapter: c,
    now: current.has(c.number),
    lessons: lessons.filter((l) => l.data.chapter === c.number),
    questions: questions.filter((q) => q.data.chapter === c.number && isClassContent(data, q)).length,
  }))
  .filter((s) => s.lessons.length > 0);
const emptyNow = taught
  .filter((c) => current.has(c.number) && !sections.some((s) => s.chapter === c))
  .sort((a, b) => a.number - b.number);
const emptyDone = taught.filter((c) => !current.has(c.number) && !sections.some((s) => s.chapter === c)).map((c) => c.number);
// Filter chips: the everyday kinds first.
const kindChips = [...LESSON_KINDS]
  .sort((a, b) => Number(a.kind === 'review') - Number(b.kind === 'review'))
  .map((k) => ({ ...k, n: lessons.filter((l) => l.data.kind === k.kind).length }))
  .filter((k) => k.n > 0);
---

<Base
  title="Lessons"
  subject={subject}
  searchable
  searchMeta={{ type: 'All lessons' }}
  description={`Every ${data.subject.name} lesson, classmates' notes page, and test review sheet, by chapter.`}
>
  <h1>Lessons</h1>
  <p class="muted intro">Lessons, classmates' notes, and test review sheets, newest chapter first.</p>

  {lessons.length > 0 && (
    <form class="filter" role="search" aria-label="Filter lessons" data-pagefind-ignore>
      <label class="visually-hidden" for="lesson-filter">Filter lessons</label>
      <input id="lesson-filter" type="search" placeholder="Filter by title, topic, or name…" autocomplete="off" enterkeyhint="done" />
      <fieldset class="kinds">
        <legend class="visually-hidden">Show</legend>
        {/* Counts follow the text filter, so each chip says how many it would show. */}
        <label class="kind-chip"><input type="radio" name="kind" value="" checked /> <span>All <span class="n" data-kind="">{lessons.length}</span></span></label>
        {kindChips.map((k) => (
          <label class="kind-chip">
            <input type="radio" name="kind" value={k.kind} /> <span>{k.kind === 'review' ? <>Review<span class="wide-only"> sheets</span></> : k.chip} <span class="n" data-kind={k.kind}>{k.n}</span></span>
          </label>
        ))}
      </fieldset>
      <p class="small muted status" aria-live="polite"></p>
    </form>
  )}

  <nav class="jump-nav" aria-label="Chapters" data-pagefind-ignore>
    {sections.length > 1 && <span class="jump-label" aria-hidden="true">Jump to</span>}
    {sections.length > 1 && sections.map((s) => <a href={`#ch-${s.chapter.number}`}>Ch. {s.chapter.number}</a>)}
    {sections.length > 1 && samples.length > 0 && <a href="#samples">Sample pages</a>}
    <a href={url(`${subject}/chapters/`)}>All chapters</a>
  </nav>

  {/* One line: the chapters on the class home's "Now in class" card that have nothing here yet. */}
  {emptyNow.length > 0 && (
    <p class="small muted now-note" data-unfiltered data-pagefind-ignore>
      <span class="badge now">Now in class</span>{' '}
      {emptyNow.map((c, i) => (
        <>
          {i > 0 && ', '}
          <a href={url(`${subject}/chapters/${c.number}/`)} title={c.title}>Ch.&nbsp;{c.number}</a>
        </>
      ))}
      {': no lessons yet.'}
    </p>
  )}

  {sections.map((s) => (
    <section class="chapter" id={`ch-${s.chapter.number}`} aria-labelledby={`ch-${s.chapter.number}-h`} data-chapter>
      <div class="chapter-head">
        <h2 id={`ch-${s.chapter.number}-h`}>
          <a href={url(`${subject}/chapters/${s.chapter.number}/`)}><span class="muted">Chapter {s.chapter.number}:</span> {s.chapter.title}</a>
        </h2>
        {s.now && <span class="badge now">Now in class</span>}
      </div>
      {s.questions > 0 && (
        <p class="small links" data-pagefind-ignore>
          <span class="muted">Practice:</span>
          <a href={practiceStart(subject, { chapter: [s.chapter.number] }, s.questions).href}>
            {practiceStart(subject, { chapter: [s.chapter.number] }, s.questions).label}
          </a>
        </p>
      )}
      <LessonList lessons={s.lessons} grouped legend={false} compact />
    </section>
  ))}

  <p class="small muted none" hidden data-pagefind-ignore>No lessons match. <button type="button" class="link-button clear">Clear the filter</button></p>

  {emptyDone.length > 0 && (
    <p class="small muted" data-unfiltered data-pagefind-ignore>
      {chapterRange(emptyDone).replace('Ch.', emptyDone.length > 1 ? 'Chapters' : 'Chapter')} {emptyDone.length > 1 ? 'have' : 'has'} no lessons on the site yet.
      See the <a href={url(`${subject}/chapters/`)}>chapter list</a> for their AP topics.
    </p>
  )}

  {samples.length > 0 && (
    <section id="samples" class="chapter samples" aria-labelledby="samples-h" data-pagefind-ignore>
      <details>
        <summary>
          <span id="samples-h" class="samples-title">Sample pages for later chapters</span>
          <span class="small muted">{plural(samples.length, 'page')}, not class material</span>
        </summary>
        <p class="small muted">
          Written to show what a lesson looks like, before the class reached {samples.length === 1 ? 'this chapter' : 'these chapters'}
          ({chapterRange([...new Set(samples.map((l) => l.data.chapter))])}). Use them as a preview at most; your class notes come first.
        </p>
        <LessonList lessons={samples} showChapter legend={false} compact />
      </details>
    </section>
  )}

  {/* Phones show no topic badges here (see LessonList compact), so no key for them either. */}
  <div class="legend">
    <TopicLegend subject={subject} topics={lessons.flatMap(topicIds)} label="AP topic badges:" />
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('form.filter');
  if (form) {
    const input = form.querySelector<HTMLInputElement>('#lesson-filter')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const none = document.querySelector<HTMLElement>('.none')!;
    const samples = document.querySelector<HTMLDetailsElement>('.samples details');
    const items = [...document.querySelectorAll<HTMLLIElement>('section.chapter .lessons > li')];
    const counts = [...form.querySelectorAll<HTMLElement>('.n[data-kind]')];
    const jumps = [...document.querySelectorAll<HTMLAnchorElement>('.jump-nav a[href^="#"]')];
    const unfiltered = [...document.querySelectorAll<HTMLElement>('[data-unfiltered]')];
    const words = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').split(/\s+/).filter(Boolean);
    const text = new Map(items.map((li) => [li, words(li.textContent ?? '').join(' ')]));
    let samplesWereOpen = samples?.open ?? false;

    const apply = () => {
      const kind = form.querySelector<HTMLInputElement>('input[name="kind"]:checked')?.value ?? '';
      const q = words(input.value);
      const filtering = kind !== '' || q.length > 0;
      let shown = 0;
      let shownClass = 0;
      const byKind = new Map<string, number>();
      for (const li of items) {
        const textOk = q.every((w) => text.get(li)!.includes(w));
        // Chip counts: class pages matching the text, whichever kind is picked.
        if (textOk && !li.closest('.samples')) {
          for (const k of ['', ...li.classList]) byKind.set(k, (byKind.get(k) ?? 0) + 1);
        }
        const ok = textOk && (!kind || li.classList.contains(kind));
        li.hidden = !ok;
        if (ok) {
          shown++;
          if (!li.closest('.samples')) shownClass++;
        }
      }
      for (const n of counts) n.textContent = String(byKind.get(n.dataset.kind!) ?? 0);
      // Hide group headings, lists, and chapters left empty.
      for (const ul of document.querySelectorAll<HTMLElement>('section.chapter .lessons')) {
        const empty = !ul.querySelector('li:not([hidden])');
        ul.hidden = empty;
        const h = ul.previousElementSibling;
        if (h?.classList.contains('group-h')) (h as HTMLElement).hidden = empty;
      }
      for (const sec of document.querySelectorAll<HTMLElement>('section.chapter')) {
        sec.hidden = !sec.querySelector('.lessons > li:not([hidden])');
      }
      // Jump links only to what's showing; notes about chapters with no lessons only when not filtering.
      for (const a of jumps) a.hidden = !!document.querySelector<HTMLElement>(a.hash)?.hidden;
      for (const el of unfiltered) el.hidden = filtering;
      // A text search that only matches sample pages opens them; clearing it restores the old state.
      if (samples) {
        if (q.length > 0 && shownClass === 0 && shown > 0) samples.open = true;
        else if (!filtering) samples.open = samplesWereOpen;
      }
      none.hidden = shown > 0;
      status.textContent = filtering ? `${shown} ${shown === 1 ? 'match' : 'matches'}` : '';
    };
    samples?.addEventListener('toggle', () => {
      if (!input.value.trim()) samplesWereOpen = samples.open;
    });
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('input', apply);
    form.addEventListener('change', apply);
    none.querySelector('.clear')!.addEventListener('click', () => {
      input.value = '';
      form.querySelector<HTMLInputElement>('input[name="kind"][value=""]')!.checked = true;
      apply();
      input.focus();
    });
  }
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    align-items: center;
    margin: 1rem 0 0.5rem;
  }
  .filter input[type='search'] {
    flex: 1 1 16rem;
    min-width: 0;
    font: inherit;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }
  .filter input[type='search']:focus {
    outline: 3px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    border: 0;
    margin: 0;
    padding: 0;
  }
  .kind-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
  }
  .kind-chip input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .kind-chip:hover {
    border-color: var(--accent);
  }
  .kind-chip:has(input:checked) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .kind-chip:has(input:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .n {
    margin-left: 0.25rem;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .status {
    flex-basis: 100%;
    margin: 0;
    min-height: 0;
  }
  .status:empty {
    display: none;
  }
  .intro {
    margin: -0.25rem 0 0;
  }
  .jump-nav {
    margin: 0.5rem 0 0;
  }
  .now-note {
    margin: 0.5rem 0 0;
  }
  .now-note .badge {
    margin-right: 0.15rem;
  }
  .legend {
    margin-top: 1.5rem;
  }
  .chapter {
    scroll-margin-top: 1rem;
  }
  .chapter-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
  }
  .chapter-head h2 {
    margin-bottom: 0.2rem;
  }
  .chapter-head h2 a {
    color: var(--text);
    text-decoration: none;
  }
  .chapter-head h2 a:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.4rem;
    margin: 0 0 0.25rem;
  }
  .chapter :global(.group-h:first-of-type) {
    margin-top: 0.75rem;
  }
  .none {
    margin-top: 1.5rem;
  }
  .clear {
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    color: var(--link);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .samples {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .samples summary {
    cursor: pointer;
  }
  .samples-title {
    font-weight: 700;
    color: var(--link);
    margin-right: 0.5rem;
  }
  /* Phones: the heading and the filter say what the page is, and the chips, jump links, and
     note each fit on one line, so the first lessons show on the first screen. */
  @media (max-width: 520px) {
    .intro,
    .legend,
    .jump-label {
      display: none;
    }
    .kinds {
      gap: 0.3rem;
    }
    .kind-chip {
      padding: 0.25rem 0.55rem;
      font-size: 0.85rem;
    }
    /* "All" needs no count when the other chips have theirs. */
    .n[data-kind=''] {
      display: none;
    }
    .jump-nav {
      gap: 0.15rem 0.7rem;
      font-size: 0.85rem;
    }
    .now-note .badge {
      font-size: 0.72rem;
    }
  }
  .samples :global(.lessons) {
    opacity: 0.9;
  }
</style>
