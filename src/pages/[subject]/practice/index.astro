---
import type { PracticeCourse } from '../../../components/practice/context';
import Practice from '../../../components/practice/Practice.svelte';
import Base from '../../../layouts/Base.astro';
import {
  getLessons,
  getQuestions,
  getSubjectData,
  inTest,
  isTaught,
  learnedTopic,
  lessonHref,
  pastFrqLinks,
  quizzes,
  subjectPaths,
  testsByDate,
  topicIds,
  url,
} from '../../../lib/content';
import { hasTests, hasTopics } from '../../../lib/features';
import { questionMeta } from '../../../lib/practice/build';
import { quickStarts } from '../../../lib/practice/presets';

export const getStaticPaths = subjectPaths;

const { subject } = Astro.params;
const data = getSubjectData(subject);
const questions = await getQuestions(subject);
const chapterNumbers = new Set(questions.map((q) => q.data.chapter));
const current = new Set(data.progress.current);
const isLearned = learnedTopic(data);
const by = ['chapter', hasTopics(data) && 'AP topic', hasTests(data) && 'class test'].filter(Boolean);
const description = `Practice questions by ${by.join(', ')}, and difficulty.`;

const course: PracticeCourse = {
  subject,
  questions: questions.map((q) => questionMeta(subject, q)),
  questionsBase: url(`${subject}/practice/questions/`),
  prefetchChapters: data.progress.current.filter((n) => chapterNumbers.has(n)),
  chapters: data.chapters.map((c) => ({
    number: c.number,
    title: c.title,
    hasQuestions: chapterNumbers.has(c.number),
    current: current.has(c.number),
    finished: data.progress.chapters.has(c.number),
  })),
  units: data.ced.units.map((u) => ({ id: u.id, title: u.title, topics: u.topics.map((t) => ({ id: t.id, title: t.title })) })),
  tests: data.tests.map((t) => ({
    id: t.id,
    title: t.title,
    kind: t.kind,
    chapters: t.chapters,
    sections: t.sections,
    exclude: t.exclude,
    exam: t.exam && { ...t.exam, noun: t.kind === 'quiz' ? ('quiz' as const) : ('exam' as const) },
  })),
  frqs: pastFrqLinks(data),
  chapterTopics: Object.fromEntries(data.chapters.map((c) => [String(c.number), c.cedTopics])),
  learnedTopics: [...data.topics.keys()].filter(isLearned),
  practiceNames: Object.fromEntries(data.ced.sciencePractices.map((p) => [p.id, p.name])),
  presets: quickStarts(
    testsByDate(data).map((t) => ({ id: t.id, title: t.title, exam: t.exam, questions: questions.filter((q) => inTest(t, q)).map((q) => q.id) })),
    questions.map((q) => ({ id: q.id, chapter: q.data.chapter })),
    new Set(data.chapters.map((c) => c.number).filter((n) => isTaught(data, n))),
    // Quick start offers a practice quiz only while the class is on its chapters.
    quizzes(data)
      .filter((t) => t.chapters.some((n) => data.progress.current.includes(n)))
      .flatMap((t) => (t.exam ? [{ id: t.id, title: t.title, exam: t.exam, minutes: t.minutes }] : [])),
  ),
  // Lessons the practice screens link to ("Study this"); notes and review sheets aren't matched to questions.
  lessons: (await getLessons(subject))
    .filter((l) => l.data.kind === 'lesson')
    .map((l) => ({ title: l.data.title, href: lessonHref(l), chapter: l.data.chapter, sections: l.data.sections, topics: topicIds(l) })),
  hrefs: { topics: url(`${subject}/ap/`), chapters: url(`${subject}/chapters/`), frqs: url(`${subject}/frqs/`) },
};
// For the inline script below: which chapters a "Start" link's set can come from.
const early = {
  base: course.questionsBase,
  withQuestions: [...chapterNumbers],
  testChapters: Object.fromEntries(data.tests.map((t) => [t.id, t.chapters])),
};
---

<Base title="Practice" subject={subject} description={description}>
  <h1 class="practice-title">Practice</h1>
  <noscript><p class="notice">Practice needs JavaScript.</p></noscript>
  {/* One JSON string: the browser parses it natively, much faster than Astro's prop format, which
      rebuilds every value of a large object one at a time. */}
  {/* Before the first paint:
      - A link that opens a set, or a reload mid-set: the page built here shows the setup screen,
        which the island replaces with the set a moment later. Say "Loading questions…" instead
        until it has (Practice.svelte removes html.practice-opening). Filter links keep the built
        setup screen; its chips update when the island starts.
      - A set: the page is laid out for it from the start (body[data-practice]).
      - A link that starts a set by chapter or test: fetch those chapters' question text now, while
        the page's scripts load (Practice.svelte picks them up from window.__practiceText). Other
        sets (by topic, say) wait for the island, which works out their chapters. */}
  <script is:inline define:vars={{ early }}>
    const p = new URLSearchParams(location.search);
    const state = history.state;
    const inSet = state && (state.phase === 'session' || state.phase === 'results');
    if (p.has('start') || inSet) document.documentElement.classList.add('practice-opening');
    // Opening a set: lay the page out for it now (no title, and no class nav on phones; see
    // global.css), so nothing jumps when it appears. Practice.svelte keeps this up to date.
    if (p.has('start') || inSet) document.body.dataset.practice = inSet ? state.phase : 'session';
    const chapters = p.has('chapter')
      ? p.get('chapter').split(',').map(Number)
      : p.get('test') && early.testChapters[p.get('test')]
        ? early.testChapters[p.get('test')]
        : [];
    if (p.has('start')) {
      window.__practiceText = {};
      for (const n of chapters.filter((n) => early.withQuestions.includes(n))) {
        window.__practiceText[n] = fetch(early.base + n + '.json').then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))));
      }
    }
  </script>
  <p class="muted opening-note" aria-live="polite">Loading questions…</p>
  <Practice client:load courseJson={JSON.stringify(course)} />
</Base>

<style>
  /* Holds the space the set will take, so the footer doesn't jump down when it appears. */
  .opening-note {
    display: none;
    min-height: 80vh;
  }
  :global(html.practice-opening) .opening-note {
    display: block;
  }
  :global(html.practice-opening astro-island) {
    display: none;
  }
</style>
