---
import Search from '../components/Search.astro';
import Base from '../layouts/Base.astro';
import { url } from '../lib/content';
import { loadRegistry } from '../lib/registry';
import { SITE_DESCRIPTION, SITE_NAME } from '../site';

const subjects = [...loadRegistry().values()];
// With one class there's nothing to choose: send "/" straight to it. A second subject in
// src/data/subjects.json brings the class picker back.
const only = subjects.length === 1 ? url(`${subjects[0]!.subject.id}/`) : undefined;
---

{only ? (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <meta http-equiv="refresh" content={`0; url=${only}`} />
      <link rel="canonical" href={only} />
      <title>{SITE_NAME}</title>
      <script is:inline define:vars={{ only }}>location.replace(only + location.search + location.hash);</script>
    </head>
    <body>
      <p><a href={only}>{subjects[0]!.subject.name}</a></p>
    </body>
  </html>
) : (
  <Base title={SITE_NAME}>
    <h1>{SITE_NAME}</h1>
    <p class="prose muted">{SITE_DESCRIPTION}</p>
    <Search />
    <h2>Classes</h2>
    <div class="grid">
      {subjects.map(({ subject, chapters, ced }) => (
        <a class="card" href={url(`${subject.id}/`)}>
          <h3>{subject.name}</h3>
          <p class="small muted">{subject.textbook}</p>
          <p class="small">
            {chapters.length} chapters · {ced.units.length} {subject.standardsName} units
          </p>
        </a>
      ))}
    </div>
  </Base>
)}
