---
import Search from '../components/Search.astro';
import Base from '../layouts/Base.astro';
import { url } from '../lib/content';
import { loadRegistry } from '../lib/registry';
import { SITE_DESCRIPTION, SITE_NAME } from '../site';

const subjects = [...loadRegistry().values()];

// With a single subject, the subject page is the home page: send visitors straight there.
// (Astro.redirect in a static build waits 2 seconds; this redirect is immediate.)
const only = subjects.length === 1 ? url(`${subjects[0]!.subject.id}/`) : null;
---

{only ? (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <title>{SITE_NAME}</title>
      <meta http-equiv="refresh" content={`0;url=${only}`} />
      <link rel="canonical" href={only} />
      <meta name="robots" content="noindex" />
      <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    </head>
    <body>
      <a href={only}>Continue to {subjects[0]!.subject.name}</a>
    </body>
  </html>
) : (
  <Base title={SITE_NAME}>
    <h1>{SITE_NAME}</h1>
    <p class="prose muted">{SITE_DESCRIPTION}</p>
    <Search />
    <h2>Subjects</h2>
    <div class="grid">
      {subjects.map(({ subject, chapters, ced }) => (
        <a class="card" href={url(`${subject.id}/`)}>
          <h3>{subject.name}</h3>
          <p class="small muted">{subject.textbook}</p>
          <p class="small">
            {chapters.length} chapters · {ced.units.length} {subject.standardsName} units
          </p>
        </a>
      ))}
    </div>
  </Base>
)}
