---
// The site's home: every class from src/data/subjects.json, each with what's going on now and
// links into it. Each class's own home is /<subject>/.
import Search from '../components/Search.astro';
import Base from '../layouts/Base.astro';
import { formatDate, getLessons, getQuestions, isClassContent, isPastTest, nowChapters, testsByDate, url } from '../lib/content';
import { loadRegistry } from '../lib/registry';
import { plural } from '../lib/text';
import { SITE_DESCRIPTION, SITE_NAME } from '../site';

const classes = await Promise.all(
  [...loadRegistry().values()].map(async (data) => {
    const id = data.subject.id;
    const lessons = (await getLessons(id)).filter((l) => isClassContent(data, l));
    const questions = (await getQuestions(id)).filter((q) => isClassContent(data, q));
    return {
      data,
      href: (path = '') => url(`${id}/${path}`),
      now: nowChapters(data),
      test: testsByDate(data)[0],
      lessons: lessons.length,
      questions: questions.length,
    };
  }),
);
---

<Base title={SITE_NAME}>
  <h1>{SITE_NAME}</h1>
  <p class="muted intro">{SITE_DESCRIPTION}</p>
  <Search />

  <h2 class="classes-h">{classes.length === 1 ? 'Class' : 'Classes'}</h2>
  <ul class="plain-list classes">
    {
      classes.map(({ data, href, now, test, lessons, questions }) => (
        <li class="card class">
          <h3>
            <a href={href()}>{data.subject.name}</a>
          </h3>
          <p class="small muted">{data.subject.textbook}</p>
          <dl>
            {now.chapters.length > 0 && (
              <div>
                <dt>{now.label}</dt>
                <dd>
                  {now.chapters.map((c, i) => (
                    <>
                      {i > 0 && <br />}
                      <a href={href(`chapters/${c.number}/`)}>
                        Ch. {c.number}: {c.title}
                      </a>
                    </>
                  ))}
                </dd>
              </div>
            )}
            {test && (
              <div data-test-date={test.date} data-past={isPastTest(test) ? '' : undefined}>
                <dt>
                  <span class="if-upcoming">Next test</span>
                  <span class="if-past">Latest test</span>
                </dt>
                <dd>
                  <a href={href(`tests/${test.id}/`)}>{test.title}</a>
                  <span class="muted">
                    {' · '}
                    {test.date ? (
                      <>
                        <span class="if-past">taken </span>
                        {formatDate(test.date)}
                      </>
                    ) : (
                      'date TBA'
                    )}
                  </span>
                </dd>
              </div>
            )}
            <div>
              <dt>So far</dt>
              <dd>
                {data.progress.chapters.size} of {plural(data.chapters.length, 'chapter')} finished
                <span class="muted"> · {plural(lessons, 'lesson')} and notes · {plural(questions, 'practice question')}</span>
              </dd>
            </div>
          </dl>
          <p class="links">
            <a class="button" href={href()}>Open {data.subject.name}</a>
            <a class="button secondary" href={href('lessons/')}>Lessons</a>
            <a class="button secondary" href={href('practice/')}>Practice</a>
            <a class="button secondary" href={href('tests/')}>Tests</a>
          </p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .intro {
    margin-top: -0.5rem;
  }
  .classes-h {
    margin-top: 1.75rem;
  }
  /* One column for one class; side by side as classes are added. */
  .classes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }
  .class h3 {
    margin: 0;
    font-size: 1.3rem;
  }
  .class h3 + p {
    margin: 0.15rem 0 0.75rem;
  }
  dl {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  dl > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0 0.75rem;
  }
  dt {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.15rem;
  }
  dd {
    margin: 0;
  }
  @media (max-width: 520px) {
    dl > div {
      grid-template-columns: 1fr;
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
  }
</style>
