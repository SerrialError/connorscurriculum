---
// The site's home: every class from src/data/subjects.json, each with what's going on now and
// links into it. Each class's own home is /<subject>/.
import Search from '../components/Search.astro';
import Base from '../layouts/Base.astro';
import TestWhen from '../components/TestWhen.astro';
import { getClassSummary, isPastTest, kindCounts, url } from '../lib/content';
import { classCardLinks, searchPlaceholder } from '../lib/features';
import { loadRegistry } from '../lib/registry';
import { plural } from '../lib/text';
import { SITE_DESCRIPTION, SITE_NAME } from '../site';

const classes = await Promise.all(
  [...loadRegistry().values()].map(async (data) => {
    const { lessons, questions, now, test } = await getClassSummary(data);
    return {
      data,
      href: (path = '') => url(`${data.subject.id}/${path}`),
      now,
      test,
      lessons: kindCounts(lessons),
      questions: questions.length,
    };
  }),
);
---

<Base title={SITE_NAME}>
  {/* The header already shows the site name, so the page is named for what it lists. */}
  <h1>{classes.length === 1 ? 'Your class' : 'Your classes'}</h1>
  <p class="muted intro">{SITE_DESCRIPTION}</p>
  <Search placeholder={searchPlaceholder()} />

  <ul class="plain-list classes" aria-label="Classes">
    {
      classes.map(({ data, href, now, test, lessons, questions }) => (
        <li class="card class">
          <h2>
            <a href={href()}>{data.subject.name}</a>
          </h2>
          <p class="small muted">{data.subject.textbook}</p>
          <dl>
            {now.chapters.length > 0 && (
              <div>
                <dt class="eyebrow">{now.label}</dt>
                <dd>
                  {now.chapters.map((c, i) => (
                    <>
                      {i > 0 && <br />}
                      <a href={href(`chapters/${c.number}/`)}>
                        Ch. {c.number}: {c.title}
                      </a>
                    </>
                  ))}
                </dd>
              </div>
            )}
            {test && (
              <div data-test-date={test.date} data-past={isPastTest(test) ? '' : undefined}>
                <dt class="eyebrow">
                  <span class="if-upcoming">Next test</span>
                  <span class="if-past">Latest test</span>
                </dt>
                <dd>
                  <a href={href(`tests/${test.id}/`)}>{test.title}</a>
                  <span class="muted">
                    {' · '}
                    <TestWhen test={test} />
                  </span>
                </dd>
              </div>
            )}
            <div>
              <dt class="eyebrow">So far</dt>
              <dd>
                {data.progress.chapters.size} of {plural(data.chapters.length, 'chapter')} finished
                <span class="muted">{[lessons, questions && plural(questions, 'practice question')].filter(Boolean).map((t) => ` · ${t}`).join('')}</span>
              </dd>
            </div>
          </dl>
          <p class="links">
            {classCardLinks(data).map((n, i) => (
              <a class:list={['button', { secondary: i > 0 }]} href={href(n.path)}>{n.label}</a>
            ))}
          </p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .intro {
    margin-top: -0.5rem;
  }
  /* One column for one class; side by side as classes are added. */
  .classes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }
  .class h2 {
    margin: 0;
    font-size: 1.3rem;
  }
  .class h2 + p {
    margin: 0.15rem 0 0.75rem;
  }
  dl {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }
  dl > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0 0.75rem;
  }
  dt {
    margin: 0;
    padding-top: 0.2rem;
  }
  dd {
    margin: 0;
  }
  @media (max-width: 520px) {
    dl > div {
      grid-template-columns: 1fr;
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
  }
</style>
